  <script>


const SNOW_COUNT = 40;

function startAnimation() {
  const CANVAS_WIDTH = window.innerWidth;
  const CANVAS_HEIGHT = window.innerHeight;

  const canvas = document.getElementById("canvas");
  const ctx = canvas.getContext("2d");

  canvas.width = CANVAS_WIDTH;
  canvas.height = CANVAS_HEIGHT;

  // Load the snowflake image
  const snowflakeImage = new Image();
  snowflakeImage.src = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='white'%3E%3Cpath d='M12 1l2.29 4.5L19 6l-2.7 2.88L17 12l-3.7-.12L12 16l-1.3-4.12L7 12l.7-3.12L5 6l4.71-.5L12 1z'/%3E%3C/svg%3E";

  // Snowflake class
  class Snowflake {
    constructor(ctx) {
      this.ctx = ctx;
      this.reset();
    }

    draw() {
      if (snowflakeImage.complete) {
        this.ctx.drawImage(snowflakeImage, this.x, this.y, this.size, this.size);
      }
    }

    reset() {
      this.size = Math.random() * 10 + 7; // Random size
      this.x = Math.random() * CANVAS_WIDTH;
      this.y = Math.random() * CANVAS_HEIGHT - CANVAS_HEIGHT;
      this.vx = (Math.random() - 0.5) * 0.5; // Random horizontal speed
      this.vy = Math.random() * 1.5 + 0.5; // Random vertical speed
    }
  }

  // Create snowflakes
  const snowflakes = Array.from({ length: SNOW_COUNT }, () => new Snowflake(ctx));

  function clearCanvas() {
    ctx.clearRect(0, 0, canvas.width, canvas.height); // Clear canvas
  }

  function animate() {
    clearCanvas();

    snowflakes.forEach((snowflake) => {
      if (snowflake.y >= CANVAS_HEIGHT || snowflake.x <= 0 || snowflake.x >= CANVAS_WIDTH) {
        snowflake.reset();
      }

      snowflake.x += snowflake.vx;
      snowflake.y += snowflake.vy;

      snowflake.draw();
    });

    requestAnimationFrame(animate);
  }

  snowflakeImage.onload = () => {
    animate(); // Start animation once the image is loaded
  };
}

startAnimation();

window.addEventListener("resize", startAnimation);



      </script>
