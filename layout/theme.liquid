    <script>
/*
==================================================
FINAL BOGO SCRIPT (Buy-1-Get-1 Redirect Logic)
Version: Handles Browser Back Button (bfcache)
==================================================
Purpose:
1. Watches for ANY product added via '/cart/add.js' on the Step 1 BOGO page.
2. Updates the progress bar (Step 1 -> Completed, Step 2 -> Active).
3. Redirects the user to the Step 2 BOGO page.
4. Resets state correctly when navigating back using the browser button (handles bfcache).
5. Sets initial progress bar state on Step 1 & Step 2 pages.

** DISCLAIMER **
This script attempts to work despite potential errors in other scripts
(like 'wishlist-element.js'). Uncaught errors elsewhere can still interfere.
==================================================
*/

(function() { // Use an IIFE to avoid polluting global scope too much

    // --- Configuration ---
    const targetPageForBogoLogic = '/pages/buy-1-get-1'; // Your Step 1 page path
    const step2PageUrl = 'https://ebodycare.in/pages/buy-1-get-1-free'; // Full URL for your Step 2 BOGO page

    // --- State ---
    // This flag determines if the redirect sequence has run for the current "showing" of the page
    let bogoRedirectLogicHasRunThisShowing = false;

    // --- Core Logic: Function to Execute After Qualifying Cart Addition ---
    function executeBogoRedirectSequence(addedProductData) {
        // Check flag first
        if (bogoRedirectLogicHasRunThisShowing) {
            console.info('BOGO SCRIPT: Redirect sequence already processed for this page showing.');
            return;
        }
        // Double-check page path
        if (window.location.pathname !== targetPageForBogoLogic) {
            console.warn('BOGO SCRIPT: executeBogoRedirectSequence called on non-target page:', window.location.pathname);
            return;
        }

        bogoRedirectLogicHasRunThisShowing = true; // Set flag immediately
        console.info(`BOGO SCRIPT: Product added on ${targetPageForBogoLogic}, triggering BOGO redirect sequence.`);

        // Update Progress Bar (Re-query elements for robustness)
        try {
            const currentStep1Link = document.querySelector('.progress-container a.step-11');
            const currentStep2Link = document.querySelector('.progress-container a.step-21');
            if (currentStep1Link && currentStep2Link) {
                currentStep1Link.classList.remove('active1', 'active');
                currentStep1Link.classList.add('completed');
                currentStep2Link.classList.add('active');
                console.info('BOGO SCRIPT: Progress bar updated.');
            } else { console.error('BOGO SCRIPT ERROR: Cannot update progress bar - step links not found.'); }
        } catch(error) { console.error('BOGO SCRIPT ERROR: Updating progress bar classes.', error); }

        // Redirect to Step 2
        setTimeout(() => {
            try {
                const linkForRedirect = document.querySelector('.progress-container a.step-21');
                const redirectUrl = linkForRedirect ? linkForRedirect.getAttribute('href') : null;
                if (redirectUrl && (redirectUrl.startsWith('http') || redirectUrl.startsWith('/'))) {
                    console.info('BOGO SCRIPT: Redirecting to:', redirectUrl);
                    window.location.href = redirectUrl;
                } else { console.error(`BOGO SCRIPT ERROR: Cannot redirect - Step 2 link missing/invalid href ("${redirectUrl}").`); }
            } catch (error) { console.error('BOGO SCRIPT ERROR: During redirection attempt.', error); }
        }, 300);
    }

    // --- Global Fetch Wrapper (Needs to be defined only once) ---
    function initializeFetchWrapper() {
        // Check if already wrapped to prevent multiple wrappings
        if (window.fetch.hasOwnProperty('isBogoWrapped')) {
             console.info('BOGO SCRIPT: Fetch wrapper already initialized.');
            return;
        }
        console.info('BOGO SCRIPT: Initializing global fetch wrapper.');
        const originalFetch = window.fetch;

        window.fetch = function(...args) {
            const resource = args[0]; const config = args[1]; let urlString = '';
            try { urlString = (typeof resource === 'string') ? resource : (resource ? resource.url : ''); } catch (e) {}

            let promise = originalFetch.apply(this, args);

            if (urlString && urlString.includes('/cart/add.js') &&
                config?.method?.toUpperCase() === 'POST' &&
                window.location.pathname === targetPageForBogoLogic) {
                console.info('BOGO SCRIPT (Fetch Wrapper): Intercepting /cart/add.js POST on target page.');
                promise = promise.then(response => {
                    const responseClone = response.clone();
                    if (response.ok) {
                        console.info('BOGO SCRIPT (Fetch Wrapper): /cart/add.js successful.');
                        responseClone.json().then(data => executeBogoRedirectSequence(data))
                           .catch(jsonError => { console.warn('BOGO SCRIPT (Fetch Wrapper): JSON parse failed.', jsonError); executeBogoRedirectSequence(null); });
                    } else { /* Log error */ responseClone.text().then(t=>console.warn(`BOGO SCRIPT (Fetch Wrapper): /cart/add.js failed. Status: ${response.status}. Response: ${t}`)).catch(()=>{}); }
                    return response; // Return original response
                }).catch(networkError => { console.error('BOGO SCRIPT (Fetch Wrapper): Network error.', networkError); throw networkError; });
            }
            return promise;
        };
         // Mark fetch as wrapped
        window.fetch.isBogoWrapped = true;
    }

    // --- Function to Set Initial Page State (Progress Bar) ---
    function setInitialPageState() {
         console.info('BOGO SCRIPT: Setting initial page state...');
         // Reset the flag whenever the page is potentially shown anew
        bogoRedirectLogicHasRunThisShowing = false;
        console.log(`%cBOGO SCRIPT: Flag reset to: ${bogoRedirectLogicHasRunThisShowing}`, "color: blue; font-weight: bold;");

        try {
            if (window.location.href.includes(step2PageUrl)) {
                // On Step 2 Page
                const step1 = document.querySelector('.progress-container a.step-11');
                const step2 = document.querySelector('.progress-container a.step-21');
                if (step1 && step2) {
                    step1.classList.add('completed'); step1.classList.remove('active', 'active1');
                    step2.classList.add('active');
                    console.info('BOGO SCRIPT (Page State): On Step 2 page. State set.');
                } else { console.warn('BOGO SCRIPT (Page State): On Step 2 page, links not found.'); }
            } else if (window.location.pathname === targetPageForBogoLogic) {
                // On Step 1 BOGO Page
                const step1 = document.querySelector('.progress-container a.step-11');
                const step2 = document.querySelector('.progress-container a.step-21');
                if (step1) {
                     step1.classList.add('active1'); // Or 'active'
                     step1.classList.remove('completed');
                     console.info('BOGO SCRIPT (Page State): On Step 1 page. Step 1 set active.');
                } else { console.warn('BOGO SCRIPT (Page State): On Step 1 page, Step 1 link not found.'); }
                if (step2) {
                    step2.classList.remove('active', 'completed');
                    console.info('BOGO SCRIPT (Page State): On Step 1 page. Step 2 state cleared.');
                }
            }
        } catch (e) { console.error("BOGO SCRIPT (Page State): Error setting initial state.", e); }
    }

    // --- Initialization and Event Listeners ---

    // Initialize the fetch wrapper once
    initializeFetchWrapper();

    // Run page state setup on initial load
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setInitialPageState);
    } else {
        // Handle cases where script loads after DOMContentLoaded (less common but safe)
        setInitialPageState();
    }

    // Add listener for pageshow event to handle bfcache restores
    window.addEventListener('pageshow', function (event) {
        // event.persisted is true if page was loaded from bfcache
        if (event.persisted) {
            console.log('%cBOGO SCRIPT: Page being shown from bfcache (persisted=true). Resetting state.', "color: red; font-weight: bold;");
            // Re-run the state setup function, which also resets the flag
            setInitialPageState();
        }
    });

    // --- Optional: Specific listeners like sizeList can still exist ---
    // Their fetch calls will be intercepted by the wrapper on the BOGO page.
    // Make sure these listeners don't have conflicting redirect/progress bar logic.
    /*
    const sizeList = document.querySelector('#size-list-45069334708382');
    if (sizeList) {
        sizeList.addEventListener('click', function (e) {
            // ... logic to get variantId and call fetch('/cart/add.js')...
            // No BOGO redirect logic needed here; wrapper handles it.
        });
        console.info("BOGO SCRIPT: Optional listener potentially attached to #size-list-45069334708382.");
    }
    */

})(); // End IIFE</script>
 



