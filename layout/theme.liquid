    <script>
      document.addEventListener("DOMContentLoaded", function() {
        // Function to add 'cart-item-freebie' class to items containing 'Freebie'
        function checkForFreebie(item) {
          if (item.innerHTML.includes("Freebie") && !item.classList.contains('cart-item-freebie')) {
            item.classList.add("cart-item-freebie");
          }
        }

        // Observer callback to handle mutations
        function handleMutation(mutations) {
          mutations.forEach((mutation) => {
            mutation.addedNodes.forEach((node) => {
              // Check if node is an element and has class 'cart-item'
              if (node.nodeType === Node.ELEMENT_NODE && node.classList.contains('cart-item')) {
                checkForFreebie(node);
              }
              // Check if any children of the node have the 'cart-item' class
              if (node.querySelectorAll) {
                node.querySelectorAll('.cart-item').forEach(checkForFreebie);
              }
            });
          });
        }

        // Options for the observer (which mutations to observe)
        const config = { childList: true, subtree: true };

        // Create an observer instance linked to the callback function
        const observer = new MutationObserver(handleMutation);

        // Start observing the target node for configured mutations
        observer.observe(document.body, config);

        // Initial check for any cart items already present
        document.querySelectorAll(".cart-item").forEach(checkForFreebie);
      });
    </script>


