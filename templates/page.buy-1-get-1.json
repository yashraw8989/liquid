r;\nborder: 3px solid var(--line-border-empty);\ntransition: .4s ease;\n}\n.circle2{\nbackground-color: #bbb9b9;\ncolor: white;\n}\n.circle.active {\nborder-color: var(--line-border-fill)\n}\n\n.btn {\nbackground-color: var(--line-border-fill);\ncolor: #fff;\nborder: 0;\nborder-radius: 6px;\ncursor: pointer;\nfont-family: inherit;\npadding: 8px 30px;\nmargin: 5px;\nfont-size: 14px;\n}\n\n.btn:active {\ntransform: scale(.98);\n}\n\n.btn:focus {\noutline: 0;\n}\n\n.btn:disabled {\nbackground-color: var(--line-border-empty);\ncursor: not-allowed;\n}\n\n<\/style>\n<!-- Krishna style -->\n<style>\n.featured-collection .grid .grid__item {\n  width: 100%;\n  max-width: 100%;\n  overflow: hidden;\n  \n  border-radius: 7px;\n \n}\n\n.grid__item a.pho {border: 1px solid #ddd;border-radius: 10px;}\n\n.grid__item a.pho img {\n  border-radius: 10px;\n}\n\n.featured-collection .grid .grid__item a {\n  display: block;\n  width: 100%;\n}\n\n.featured-collection .grid .grid__item a img {\n  display: block;\n  width: 100%;\n  height: 433px;\n  \/* background: red; *\/\n  \/* aspect-ratio: 11 \/ 11; *\/\n  \/* object-fit: cover; *\/\n}\n\n.featured-collection .grid.grid--uniform {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));\n  gap: 37px 43px;\n}\n\n\/* .pdetails-part {\n  padding: 0px 15px;\n} *\/\n\n.pdetails-part h3 {\n  font-size: 19px;\n  letter-spacing: 0;\n  text-transform: capitalize !important;\n  font-weight: 500;\n  color: #000000;\n  display: -webkit-box;\n  -webkit-line-clamp: 1;\n  -webkit-box-orient: vertical;\n  font-size: clamp(16px, calc(14 * (100vw \/ 1440)), 17px);\n  overflow: hidden;\n}\n\n.price-button {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: 1.5rem !important;\n  margin-bottom: .5rem;\n  padding-top: 1rem;\n}\n\nmain.buyone-getone-page button {\npadding: 2px 15px;\n  border: 1px solid #bfbfbf;\n  background: #fe0008;\n  color: white;\n  border-radius: 5px;\n  margin-bottom