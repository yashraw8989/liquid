dustry. <\/div>-->\n     <\/div>\n     <\/a>\n    <\/div>\n    <\/div>\n\n\n<!-- progress bar end -->\n{% assign collection = collections['b1g1-buy-dc'] %}\n{{ 'template-collection.css' | asset_url | stylesheet_tag }}\n{{ 'component-card.css' | asset_url | stylesheet_tag }}\n{{ 'component-price.css' | asset_url | stylesheet_tag }}\n\n{% if section.settings.image_shape == 'blob' %}\n  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}\n{%- endif -%}\n\n{%- if section.settings.enable_quick_add -%}\n  {{ 'quick-add.css' | asset_url | stylesheet_tag }}\n  <script src=\"{{ 'quick-add.js' | asset_url }}\" defer=\"defer\"><\/script>\n  <script src=\"{{ 'product-form.js' | asset_url }}\" defer=\"defer\"><\/script>\n{%- endif -%}\n\n{%- style -%}\n  .section-{{ section.id }}-padding {\n    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;\n    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;\n  }\n\n  @media screen and (min-width: 750px) {\n    .section-{{ section.id }}-padding {\n      padding-top: {{ section.settings.padding_top }}px;\n      padding-bottom: {{ section.settings.padding_bottom }}px;\n    }\n  }\n\n  .color-filter-button {\n    position: relative;\n    padding-right: 20px; \/ Space for the cross button \/\n  }\n\n  .color-filter-button .remove-filter {\n    position: absolute;\n    top: 50%;\n    right: 5px;\n    transform: translateY(-50%);\n    cursor: pointer;\n    display: none; \/ Initially hidden \/\n  }\n\n  .color-filter-button.active .remove-filter {\n    display: inline; \/ Show only for active buttons \/\n  }\n  \n  .product-item--out-of-stock {\n    opacity: 0.5;\n    position: relative;\n  }\n\n  .product-item--out-of-stock .product-card {\n    position: relative;\n  }\n\n  .product-item--out-of-stock .product-card:after {\n    content: \"Out of Stock\";\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: rgba(255, 255, 255, 0.8);\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    font-size: 1.5em;\n    color: red;\n    font-weight: bold;\n  }\n{%- endstyle -%}\n\n<div class=\"section-{{ section.id }}-padding\">\n  {%- paginate collection.products by section.settings.products_per_page -%}\n    <div class=\"{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}\">\n      {{ 'component-facets.css' | asset_url | stylesheet_tag }}\n      <script src=\"{{ 'facets.js' | asset_url }}\" defer=\"defer\"><\/script>\n      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}\n        {% assign available_products_count = 0 %}\n\n        {% if collection.products_count > 0 %}\n          {% for product in collection.products %}\n            {% if product.available %}\n              {% assign available_products_count = available_products_count | plus: 1 %}\n            {% endif %}\n          {% endfor %}\n\n          {% if available_products_count > 0 %}\n            {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}\n              <aside\n                aria-labelledby=\"verticalTitle\"\n                class=\"facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}\"\n                id=\"main-collection-filters\"\n                data-id=\"{{ section.id }}\"\n              >\n                {% render 'facetsalt',\n                  results: collection,\n                  enable_filtering: section.settings.enable_filtering,\n                  enable_sorting: section.settings.enable_sorting,\n                  filter_type: section.settings.filter_type,\n                  paginate: paginate\n                %}\n              <\/aside>\n            {% endif %}\n\n          {% endif %}\n        {% endif %}\n      {%- endif -%}\n\n      <div\n        class=\"product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}\"\n        id=\"ProductGridContainer\"\n        {% if settings.animations_reveal_on_scroll %}\n          data-cascade\n        {% endif %}\n      >\n        {%- if collection.products.size == 0 -%}\n          <div class=\"collection collection--empty page-width\" id=\"product-grid\" data-id=\"{{ section.id }}\">\n            <div class=\"loading-overlay gradient\"><\/div>\n            <div class=\"title-wrapper center\">\n              <h2 class=\"title title--primary\">\n                {{ 'sections.collection_template.empty' | t }}\n                {% comment %}\n                  <br>\n                  {{\n                    'sections.collection_template.use_fewer_filters_html'\n                    | t: link: collection.url, class: 'underlined-link link'\n                  }}\n                {% endcomment %}\n              <\/h2>\n            <\/div>\n          <\/div>\n        {%- else -%}\n          <div class=\"collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}\">\n            <div class=\"loading-overlay gradient\"><\/div>\n            <ul\n              id=\"product-grid\"\n              data-id=\"{{ section.id }}\"\n              class=\"grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop\"\n            >\n{%- for product in collection.products -%}\n  {% assign lazy_load = false %}\n  {%- if forloop.index > 2 -%}\n    {%- assign lazy_load = true -%}\n  {%- endif -%}\n  {% assign product_colors = product.metafields.custom.product_color_name.value %}\n  \n  <li\n    class=\"grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}{% unless product.available %} product-item--out-of-stock{% endunless %}\"\n    {% if settings.animations_reveal_on_scroll %}\n      data-cascade style=\"--animation-order: {{ forloop.index }};\"\n    {% endif %}\n    data-colors=\"{{ product_colors | escape }}\"\n  >\n{% if product.tags contains 'buy 2 get 1 free' %}\n  {% render 'card-product-offer-badge',\n    card_product: product,\n    media_aspect_ratio: section.settings.image_ratio,\n    image_shape: section.settings.image_shape,\n    show_secondary_image: section.settings.show_secondary_image,\n    show_vendor: section.settings.show_vendor,\n    show_rating: section.settings.show_rating,\n    lazy_load: lazy_load,\n    show_quick_add: section.settings.enable_quick_add,\n    section_id: section.id %}\n  \n{% elsif product.tags contains 'Bodyx Freebie Offer' %}\n  {% render 'card-product-offer-badge-freebie',\n    card_product: product,\n    media_aspect_ratio: section.settings.image_ratio,\n    image_shape: section.settings.image_shape,\n    show_secondary_image: section.settings.show_secondary_image,\n    show_vendor: section.settings.show_vendor,\n    show_rating: section.settings.show_rating,\n    lazy_load: lazy_load,\n    show_quick_add: section.settings.enable_quick_add,\n    section_id: section.id %}\n\n  \n  \n{% else %}\n  {% render 'card-pro-b1gone',\n    card_product: product,\n    media_aspect_ratio: section.settings.image_ratio,\n    image_shape: section.settings.image_shape,\n    show_secondary_image: section.settings.show_secondary_image,\n    show_vendor: section.settings.show_vendor,\n    show_rating: section.settings.show_rating,\n    lazy_load: lazy_load,\n    show_quick_add: section.settings.enable_quick_add,\n    section_id: section.id %}\n  \n{% endif %}\n\n    \n    {% unless product.available %}\n      <div class=\"product-card__overlay\" style=\"display: none;\">Out of Stock<\/div>\n    {% endunless %}\n  <\/li>\n{%- endfor -%}\n<\/ul>\n\n            {%- if paginate.pages > 1 -%}\n              {% render 'pagination', paginate: paginate, anchor: '' %}\n            {%- endif -%}\n          <\/div>\n        {%- endif -%}\n      <\/div>\n\n\n      \n    <\/div>\n  {%- endpaginate -%}\n  {% if section.settings.image_shape == 'arch' %}\n    {% render 'mask-arch' %}\n  {%- endif -%}\n<\/div>\n\n<!-- Add JavaScript for Filtering -->\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    var selectedFilters = new Set();\n\n    function updateFilters() {\n      var products = document.querySelectorAll('.grid__item');\n\n      products.forEach(function(product) {\n        var productColors = product.getAttribute('data-colors');\n        if (productColors) {\n          productColors = productColors.split(',');\n        } else {\n          productColors = [];\n        }\n\n        var showProduct = Array.from(selectedFilters).some(function(color) {\n          return productColors.includes(color);\n        });\n\n        if (selectedFilters.size === 0 || showProduct) {\n          product.style.display = 'block';\n        } else {\n          product.style.display = 'none';\n        }\n      });\n    }\n\n    document.querySelectorAll('.color-filter-button').forEach(function(button) {\n      button.addEventListener('click', function() {\n        var selectedColor = this.getAttribute('data-color');\n\n        if (selectedColor === 'all') {\n          selectedFilters.clear();\n          document.querySelectorAll('.color-filter-button').forEach(function(btn) {\n            btn.classList.remove('active');\n          });\n          this.classList.add('active');\n        } else {\n          if (selectedFilters.has(selectedColor)) {\n            selectedFilters.delete(selectedColor);\n            this.classList.remove('active');\n          } else {\n            selectedFilters.add(selectedColor);\n            this.classList.add('active');\n          }\n          document.querySelector('.color-filter-button[data-color=\"all\"]').classList.remove('active');\n        }\n\n        updateFilters();\n      });\n    });\n\n    document.querySelectorAll('.remove-filter').forEach(function(removeButton) {\n      removeButton.addEventListener('click', function(event) {\n        event.stopPropagation();\n        var button = this.parentElement;\n        var color = button.getAttribute('data-color');\n        selectedFilters.delete(color);\n        button.classList.remove('active');\n        updateFilters();\n      });\n    });\n  });\n<\/script>\n<\/main>\n<!-- section 2 -->","color_scheme":"","padding_top":40,"padding_bottom":52}},"custom_liquid_rjfTFm":{"type":"custom-liquid","disabled":true,"settings":{"custom_liquid":"<div class=\"product-details page-width\">\n  <div class=\"mycontaine\">\n            <div class=\"p-0 col-sm-12\">\n                      <p style=\"color: #000; font-weight:400;\">Mark your entrance without saying a word!\n\n                        When you meet someone, what leads your vibe is the silent signature of the fragrance you carry. Make it iconic with BodyX Perfumes!\n                        \n                        An olfactory symphony that embodies the spirit of modern refinement, the BodyX perfume range is designed for those who believe in making an impression that lingers, with each note carefully crafted to elevate your everyday presence—be it at work, on a date, or during a night out with friends.\n                        \n                        Step into every room with confidence. Smell unforgettable. Live iconic.<\/p>\n            <\/div>\n  <\/div>\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}},"b1g1_JUjtMx":{"type":"b1g1","name":"Buy One Get One Free","settings":{"left_image":"shopify:\/\/shop_images\/Perfume-Banner-750-x-400.jpg","heading":"Buy 1 Get 1 Free – Limited Time Offer","subheading":"Mark your entrance without saying a word!","description":"<p>When you meet someone, what leads your vibe is the silent signature of the fragrance you carry. Make it iconic with BodyX Perfumes!<br\/>An olfactory symphony that embodies the spirit of modern refinement, the BodyX perfume range is designed for those who believe in making an impr