k_two":"","button_link_three":"","button_link_four":"","button_text":"EXPLORE MORE","button_bg_color":"#fe0008","button_text_color":"#ffffff","button_hover_text_color":"#fe0008","button_hover_color":"#ecbdd6"}},"171497346483019b36":{"type":"apps","blocks":{"judge_me_reviews_review_widget_F37xjw":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/review_widget\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{}}},"block_order":["judge_me_reviews_review_widget_F37xjw"],"disabled":true,"settings":{"include_margins":true}},"custom_liquid_YUTnnp":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"z-ind-desk\" style=\"display: none;\">\n<div class=\"z-indi\">\n  <div class=\"maxe h \" >\n<div class=\"pricetitle\"><h5>{{ product.title }}<\/h5>\n<div class=\"pricetax\"><h5>{% render 'price', product: product %}<\/h5><p>(Incl. of All Taxes)<\/p><\/div><\/div>\n  {% if product.available %}\n    \n    <form action=\"\/cart\/add\" method=\"post\" enctype=\"multipart\/form-data\" class=\"add-to-cart-formm\">\n    <input type=\"hidden\" name=\"id\" value=\"{{ product.variants.first.id }}\">\n      {% comment %}<input type=\"text\" name=\"locqty\" id=\"locqty\">{% endcomment %}\n    <button type=\"submit\" class=\"cart-buttonn nionx-btn nionx-btn--base \">\n      \n     <span class=\"middle_buy\">  Add to Cart  <\/span> \n     \n       <\/button>\n  <\/form>\n    {% else %}\n    <button type=\"submit\" class=\"cart-buttonn nionx-btn nionx-btn--base cart-button-maxe disabled\">Sold Out  <\/button>\n    {% endif %}\n  <\/div><\/div><\/div>\n\n\n<script>\n document.addEventListener(\"DOMContentLoaded\", function() {\n  const observer = new IntersectionObserver((entries) => {\n    \/\/ Loop over the entries\n    entries.forEach(entry => {\n      \/\/ Check the intersection ratio\n      if (entry.isIntersecting) {\n        \/\/ If the .product--large is visible, hide .z-ind-desk\n        document.querySelector('.z-ind-desk').style.display = 'none';\n      } else {\n        \/\/ If the .product--large is not visible, show .z-ind-desk\n        document.querySelector('.z-ind-desk').style.display = 'block';\n      }\n    });\n  }, {\n    \/\/ Observing for any part of the target being out of view\n    threshold: 0\n  });\n\n  \/\/ Target the element to observe\n  const target = document.querySelector('.product--large');\n  observer.observe(target);\n});\n\n    <\/script>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  \/\/ Function to update the product variant ID in custom add-to-cart buttons\n  function updateCustomCartButtons(variantId) {\n    \/\/ Query all custom forms by their class and update their hidden input field for product ID\n    document.querySelectorAll('.add-to-cart-formm input[name=\"id\"]').forEach(input => {\n      input.value = variantId;\n    });\n  }\n\n  \/\/ Listen for changes in the Shopify native add-to-cart form\n  const nativeSelect = document.querySelector('.product-variant-id');\n  nativeSelect.addEventListener('change', function() {\n    const newVariantId = this.value;\n    updateCustomCartButtons(newVariantId);\n  });\n\n  \/\/ Initialize the custom cart buttons with the current variant ID from the native button\n  if (nativeSelect) {\n    updateCustomCartButtons(nativeSelect.value);\n  }\n});\n<\/script>\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    \/\/ Function to fetch and update the product variant details\n    function fetchAndUpdateVariantDetails(variantId) {\n      const url = `\/variants\/${variantId}.js`;\n  \n      fetch(url)\n        .then(response => response.json())\n        .then(variant => {\n          const addButton = document.querySelector('.cart-buttonn');\n          const soldOutButton = document.querySelector('.cart-button-maxe.disabled');\n          \n          if (variant.available) {\n            addButton.style.display = 'block';  \/\/ Show \"Add to Cart\" button\n            soldOutButton.style.display = 'none';  \/\/ Hide \"Sold Out\" button\n          } else {\n            addButton.style.display = 'none';  \/\/ Hide \"Add to Cart\" button\n            soldOutButton.style.display = 'block';  \/\/ Show \"Sold Out\" button\n          }\n        })\n        .catch(error => console.error('Error fetching variant:', error));\n    }\n  \n    \/\/ Update variant details when the variant selection changes\n    const nativeSelect = document.querySelector('.product-variant-id');\n    nativeSelect.addEventListener('change', function() {\n      const newVariantId = this.value;\n      fetchAndUpdateVariantDetails(newVariantId);\n    });\n  \n    \/\/ Initialize with the current selected variant\n    if (nativeSelect) {\n      fetchAndUpdateVariantDetails(nativeSelect.value);\n    }\n  });\n  <\/script>","color_scheme":"","padding_top":0,"padding_bottom":0}}},"order":["main","trust_badge_digPz4","custom_liquid_eDJhVG","related-products","explore_endless_possibilities_hUck3d","171497346483019b36","custom_liquid_YUTnnp"]}