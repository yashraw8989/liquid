ion.settings.enable_quick_add,\n      section_id: section.id %}\n    \n  {% endif %}\n  \n      \n      {% unless product.available %}\n        <div class=\"product-card__overlay\" style=\"display: none;\">Out of Stock<\/div>\n      {% endunless %}\n    <\/li>\n  {%- endfor -%}\n  <\/ul>\n  \n              {%- if paginate.pages > 1 -%}\n                {% render 'pagination', paginate: paginate, anchor: '' %}\n              {%- endif -%}\n            <\/div>\n          {%- endif -%}\n        <\/div>\n  \n\n  \n        \n      <\/div>\n    {%- endpaginate -%}\n    {% if section.settings.image_shape == 'arch' %}\n      {% render 'mask-arch' %}\n    {%- endif -%}\n  <\/div>\n  \n  <!-- Add JavaScript for Filtering -->\n  <script>\n    document.addEventListener('DOMContentLoaded', function() {\n      var selectedFilters = new Set();\n  \n      function updateFilters() {\n        var products = document.querySelectorAll('.grid__item');\n  \n        products.forEach(function(product) {\n          var productColors = product.getAttribute('data-colors');\n          if (productColors) {\n            productColors = productColors.split(',');\n          } else {\n            productColors = [];\n          }\n  \n          var showProduct = Array.from(selectedFilters).some(function(color) {\n            return productColors.includes(color);\n          });\n  \n          if (selectedFilters.size === 0 || showProduct) {\n            product.style.display = 'block';\n          } else {\n            product.style.display = 'none';\n          }\n        });\n      }\n  \n      document.querySelectorAll('.color-filter-button').forEach(function(button) {\n        button.addEventListener('click', function() {\n          var selectedColor = this.getAttribute('data-color');\n  \n          if (selectedColor === 'all') {\n            selectedFilters.clear();\n            document.querySelectorAll('.color-filter-button').forEach(function(btn) {\n              btn.classList.remove('active');\n            });\n            this.classList.add('active');\n          } else {\n            if (selectedFilters.has(selectedColor)) {\n              selectedFilters.delete(selectedColor);\n              this.classList.remove('active');\n            } else {\n              selectedFilters.add(selectedColor);\n              this.classList.add('active');\n            }\n            document.querySelector('.color-filter-button[data-color=\"all\"]').classList.remove('active');\n          }\n  \n          updateFilters();\n        });\n      });\n  \n      document.querySelectorAll('.remove-filter').forEach(function(removeButton) {\n        removeButton.addEventListener('click', function(event) {\n          event.stopPropagation();\n          var button = this.parentElement;\n          var color = button.getAttribute('data-color');\n          selectedFilters.delete(color);\n          button.classList.remove('active');\n          updateFilters();\n        });\n      });\n    });\n  <\/script>\n  \n\n\n<\/main>\n<!-- section 2 -->","color_scheme":"","padding_top":40,"padding_bottom":52}},"custom_liquid_BtQVm3":{"type":"custom-liquid","disabled":true,"name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"","color_scheme":"","padding_top":40,"padding_bottom":52}},"buy_one_get_one_free_section_dAzB67":{"type":"buy-one-get-one-free-section","name":"b1g1 Free Products","settings":{"title_image":"shopify:\/\/shop_images\/25-ML-Fergrance-Banner-750-x-400.jpg","heading":"b1g1 Free Products","heading_alignment":"left","subheading":"Choose Your Free Gift Here","subheading_alignment":"left","description":"","step_1_label":"STEP 1","step_1_description":"","step_1_link":"","step_1_active":true,"step_2_link":"shopify:\/\/pages\/buy-1-get-1-free","heading_font_size":2,"heading_color":"#000000","heading_text_transform":"uppercase","heading_font_weight":700,"heading_line_height":3}}},"order":["main","custom_liquid_GPwzKp","custom_liquid_BtQVm3","buy_one_get_one_free_s