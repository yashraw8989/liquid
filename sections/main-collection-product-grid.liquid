

{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.enable_quick_add -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .color-filter-button {
    position: relative;
    padding-right: 20px; /* Space for the cross button */
  }

  .color-filter-button .remove-filter {
    position: absolute;
    top: 50%;
    right: 5px;
    transform: translateY(-50%);
    cursor: pointer;
    display: none; /* Initially hidden */
  }

  .color-filter-button.active .remove-filter {
    display: inline; /* Show only for active buttons */
  }
  
  .product-item--out-of-stock {
    opacity: 0.5;
    position: relative;
  }

  .product-item--out-of-stock .product-card {
    position: relative;
  }

  .product-item--out-of-stock .product-card:after {
    content: "Out of Stock";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.8);
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.5em;
    color: red;
    font-weight: bold;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        {% assign available_products_count = 0 %}

        {% if collection.products_count > 0 %}
          {% for product in collection.products %}
            {% if product.available %}
              {% assign available_products_count = available_products_count | plus: 1 %}
            {% endif %}
          {% endfor %}

          {% if available_products_count > 0 %}
            {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
              <aside
                aria-labelledby="verticalTitle"
                class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
                id="main-collection-filters"
                data-id="{{ section.id }}"
              >
                {% render 'facetsalt',
                  results: collection,
                  enable_filtering: section.settings.enable_filtering,
                  enable_sorting: section.settings.enable_sorting,
                  filter_type: section.settings.filter_type,
                  paginate: paginate
                %}
              </aside>
            {% endif %}

          {% endif %}
        {% endif %}
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t }}
                {% comment %}
                  <br>
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: collection.url, class: 'underlined-link link'
                  }}
                {% endcomment %}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}">
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
            >
{%- for product in collection.products -%}
  {% assign lazy_load = false %}
  {%- if forloop.index > 2 -%}
    {%- assign lazy_load = true -%}
  {%- endif -%}
  {% assign product_colors = product.metafields.custom.product_color_name.value %}
  
  <li
    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}{% unless product.available %} product-item--out-of-stock{% endunless %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade style="--animation-order: {{ forloop.index }};"
    {% endif %}
    data-colors="{{ product_colors | escape }}"
  >
{% if product.tags contains 'buy 2 get 1 free' %}
  {% render 'card-product-offer-badge',
    card_product: product,
    media_aspect_ratio: section.settings.image_ratio,
    image_shape: section.settings.image_shape,
    show_secondary_image: section.settings.show_secondary_image,
    show_vendor: section.settings.show_vendor,
    show_rating: section.settings.show_rating,
    lazy_load: lazy_load,
    show_quick_add: section.settings.enable_quick_add,
    section_id: section.id %}
  
{% elsif product.tags contains 'Bodyx Freebie Offer' %}
  {% render 'card-product-offer-badge-freebie',
    card_product: product,
    media_aspect_ratio: section.settings.image_ratio,
    image_shape: section.settings.image_shape,
    show_secondary_image: section.settings.show_secondary_image,
    show_vendor: section.settings.show_vendor,
    show_rating: section.settings.show_rating,
    lazy_load: lazy_load,
    show_quick_add: section.settings.enable_quick_add,
    section_id: section.id %}

  
  
{% else %}
  {% render 'card-product',
    card_product: product,
    media_aspect_ratio: section.settings.image_ratio,
    image_shape: section.settings.image_shape,
    show_secondary_image: section.settings.show_secondary_image,
    show_vendor: section.settings.show_vendor,
    show_rating: section.settings.show_rating,
    lazy_load: lazy_load,
    show_quick_add: section.settings.enable_quick_add,
    section_id: section.id %}
  
{% endif %}

    
    {% unless product.available %}
      <div class="product-card__overlay" style="display: none;">Out of Stock</div>
    {% endunless %}
  </li>
{%- endfor -%}
</ul>

            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

<div class="seo_content_clp"><div class="page-width">{{ collection.metafields.custom.seo_content}}</div></div>

      
    </div>
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {% render 'mask-arch' %}
  {%- endif -%}
</div>

<!-- Add JavaScript for Filtering -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var selectedFilters = new Set();

    function updateFilters() {
      var products = document.querySelectorAll('.grid__item');

      products.forEach(function(product) {
        var productColors = product.getAttribute('data-colors');
        if (productColors) {
          productColors = productColors.split(',');
        } else {
          productColors = [];
        }

        var showProduct = Array.from(selectedFilters).some(function(color) {
          return productColors.includes(color);
        });

        if (selectedFilters.size === 0 || showProduct) {
          product.style.display = 'block';
        } else {
          product.style.display = 'none';
        }
      });
    }

    document.querySelectorAll('.color-filter-button').forEach(function(button) {
      button.addEventListener('click', function() {
        var selectedColor = this.getAttribute('data-color');

        if (selectedColor === 'all') {
          selectedFilters.clear();
          document.querySelectorAll('.color-filter-button').forEach(function(btn) {
            btn.classList.remove('active');
          });
          this.classList.add('active');
        } else {
          if (selectedFilters.has(selectedColor)) {
            selectedFilters.delete(selectedColor);
            this.classList.remove('active');
          } else {
            selectedFilters.add(selectedColor);
            this.classList.add('active');
          }
          document.querySelector('.color-filter-button[data-color="all"]').classList.remove('active');
        }

        updateFilters();
      });
    });

    document.querySelectorAll('.remove-filter').forEach(function(removeButton) {
      removeButton.addEventListener('click', function(event) {
        event.stopPropagation();
        var button = this.parentElement;
        var color = button.getAttribute('data-color');
        selectedFilters.delete(color);
        button.classList.remove('active');
        updateFilters();
      });
    });
  });
</script>
{% schema %}
