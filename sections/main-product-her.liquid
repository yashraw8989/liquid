        <script>
function handleAllBrasClickPopup(event) {
    event.preventDefault();

    var link = event.currentTarget;
    var mainSizeData = link.getAttribute('data-main-sizes');
    var variantInfoData = link.getAttribute('data-variant-info');

    if (!mainSizeData || !variantInfoData) {
        console.error('Missing data attributes');
        return;
    }

    var mainSizes = mainSizeData.split(',').filter(Boolean);
    var variantInfo = JSON.parse(variantInfoData.replace(/&quot;/g, '"'));

    showSizePopup(mainSizes, variantInfo);
}

function showSizePopup(mainSizes, variantInfo) {
    var modal = document.getElementById('size-modal');
    if (!modal) {
        modal = document.createElement('div');
        modal.id = 'size-modal';
        modal.style.position = 'fixed';
        modal.style.left = '50%';
        modal.style.top = '50%';
        modal.style.transform = 'translate(-50%, -50%)';
        modal.style.background = '#fff';
        modal.style.padding = '20px';
        modal.style.boxShadow = '0 0 10px rgba(0, 0, 0, 0.5)';
        modal.style.zIndex = '1000';
        modal.style.maxWidth = '500px';
        modal.style.width = '80%';
        modal.style.textAlign = 'center';
        document.body.appendChild(modal);
    }

    var modalContent = `
    <div class="mysizechart">
        <div class="tabs">
            <button class="tab-button active" onclick="showTabContent('size-chart-content')">Size Chart</button>
            <button class="tab-button" onclick="showTabContent('know-your-size-content')">Know Your Size</button>
        </div>
        <div id="size-chart-content" class="tab-content">
            <h3 class="pickYourSize">Pick your size</h3>
            <div id="main-sizes">
                <ul>
                    ${mainSizes.map(size => size.trim() ? `<li><button class="main-size-button sizenumber" onclick="showSubSizes('${size.trim()}', '${JSON.stringify(variantInfo).replace(/'/g, "\\'").replace(/"/g, '&quot;')}')">${size.trim()}</button></li>` : '').join('')}
                </ul>
            </div>
            <div id="sub-sizes-table"></div>
        </div>
        <div id="know-your-size-content" class="tab-content" style="display: none;">
            <div class="bra-size">
                <form id="bra-size-form-calculator">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12 underbust-bef" style="position:relative;">
                            <label for="underbust">Underbust measurement (in cm)</label>
                            <input type="number" id="underbust" name="underbust" min="63" max="107" step="0.5" required>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12 overbust-bef" style="position:relative;">
                            <label for="overbust">Overbust measurement (in cm)</label>
                            <input type="number" id="overbust" name="overbust" min="78" max="134" step="0.5" required>
                        </div>
                    </div>
                </form>
                <div id="bra-size-result"></div>
            </div>
        </div>
        <button onclick="closeSizePopup()" class="closepopup1">X</button>
      </div>
    `;

    modal.innerHTML = modalContent;
    modal.style.display = 'block';

    showTabContent('size-chart-content');

    if (mainSizes.length > 0) {
        showSubSizes(mainSizes[0].trim(), JSON.stringify(variantInfo).replace(/'/g, "\\'").replace(/"/g, '&quot;'));
    }

    // Add event listeners to input fields
    document.getElementById('underbust').addEventListener('input', calculateBraSize);
    document.getElementById('overbust').addEventListener('input', calculateBraSize);
}

function showSubSizes(selectedMainSize, variantInfoData) {
    var variantInfo = JSON.parse(variantInfoData.replace(/&quot;/g, '"'));
    var filteredVariants = variantInfo.filter(variant => variant.size.toUpperCase().startsWith(selectedMainSize.toUpperCase().trim()));
    var subSizesTable = document.getElementById('sub-sizes-table');

    if (subSizesTable) {
        var tableContent = '<table><tr><th>Overbust (cm)</th><th>Underbust (cm)</th><th>Sub-size</th></tr>';
        tableContent += filteredVariants.length > 0 ?
            filteredVariants.map(variant => `<tr><td>${variant.overbust || 'N/A'}</td><td>${variant.underbust || 'N/A'}</td><td>${variant.size}</td></tr>`).join('') :
            '<tr><td colspan="3">No sub-sizes available</td></tr>';
        tableContent += '</table>';
        subSizesTable.innerHTML = tableContent;
    }
}

function showTabContent(tabId) {
    var tabs = document.querySelectorAll('.tab-content');
    tabs.forEach(tab => tab.style.display = 'none');
    document.getElementById(tabId).style.display = 'block';

    var buttons = document.querySelectorAll('.tab-button');
    buttons.forEach(button => button.classList.remove('active'));
    document.querySelector(`button[onclick="showTabContent('${tabId}')"]`).classList.add('active');
}

