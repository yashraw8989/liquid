  or product.tags contains 'bra sale' or product.tags contains 'panty sale' or product.tags contains 'shapewear sale' or product.tags contains 'buy 2 get 1 free'
  or product.tags contains 'women capris buy 2 get 1 free' or product.tags contains 'men lowers buy 2 get 1 free' or product.tags contains 'men shorts buy 2 get 1 free' or product.tags contains 'women lowers buy 2 get 1 free'
  or product.tags contains 'men t shirts buy 2 get 1 free' or product.tags contains 'panties buy 2 get 1 free' or product.tags contains 'bras buy 2 get 1 free'
  or product.tags contains 'camisoles buy 2 get 1 free' or product.tags contains 'bridal lingerie sets buy 2 get 1 free' or product.tags contains 'women t shirts buy 2 get 1 free'
  or product.tags contains 'twentypercentoff' or product.tags contains 'men sweatshirt' or product.tags contains 'women sweatshirt' or product.tags contains 'sweatshirt' 
  
