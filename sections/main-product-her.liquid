{% endif %}


                
                <a href="{{ product.url }}" class="product__title">
                  <h2 class="h1">
                    {{ product.title | escape }}
                  </h2>
                </a>
                {% assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin %}
                {% render 'share-button', share_link: share_url %}
              </div>

            {%- when 'price' -%}
              <div class="no-js-hidden" id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                                  {%- render 'price',
                  product: product,
                  use_variant: true,
                  show_badges: true,
                  price_class: 'price--large'
                -%}
                
             
              </div>
            
{%- assign related_product_handles = product.metafields.custom.product_color | split: ',' -%}
{%- assign current_product_handle = product.handle -%}

<div class="color-swatches owl-carousel owl-theme">
  {%- for handle in related_product_handles -%}
    {%- assign related_product = all_products[handle] -%}
    {%- if handle != blank -%}
      {%- assign related_product = all_products[handle] -%}
      {%- if related_product -%}
        {%- assign product_color = related_product.metafields.custom.product_color_name -%}
        <div class="item related-product color-swatches-item 
          {% if handle == current_product_handle %}active-product{% endif %} 
          {% unless related_product.available %}unavailable-product{% endunless %}">
          <a href="{{ related_product.url }}">
           <span> <img
              class="{% if handle == current_product_handle %}active{% endif %}"
              src="{{ related_product.featured_image | img_url: '600x600' }}"
              alt="{{ related_product.title }}"
            ></span>
            {%- if product_color -%}
              <p class="colorNameMain">{{ product_color }}</p>
            {%- endif -%}
            {%- unless related_product.available -%}
              <!-- <p class="out-of-stock-label">Out of Stock</p> -->
            {%- endunless -%}
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
</div>

            
