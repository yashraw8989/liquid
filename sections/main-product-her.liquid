	margin: 10px;
	font-size: 18px;
	font-weight: 600;
	transition: all 0.5s;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
}
.owl-theme .owl-nav .disabled,
button.disabled {
	opacity: 0.6;
}
  @media only screen and (max-width: 767px){
  .owl-carousel .item {
    font-size: 30px;
    text-align: center;
    padding: 2px 7px;
    line-height: 2;
    /* font-weight: 700; */
    /* background-color: #eee; */
}
  .owl-nav button span {
