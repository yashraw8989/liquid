{% assign has_bra_tag = false %}
{% assign has_sports_bra_tag = false %}
                
{% for tag in product.tags %}
    {% if tag == "bra" %}
        {% assign has_bra_tag = true %}
    {% endif %}
    {% if tag == "sports bra" %}
        {% assign has_sports_bra_tag = true %}
    {% endif %}
{% endfor %}

{% assign has_both_tags = false %}
                
{% if has_bra_tag and has_sports_bra_tag %}
    {% assign has_both_tags = true %}
{% endif %}


{% if has_both_tags %}
    <!-- Both "bra" and "sports bra" tags: Show size chart button -->
    <button
        id="ProductPopup-{{ block.id }}"
        class="product-popup-modal__button link"
        type="button"
        aria-haspopup="dialog"
        onclick="handleAllBrasClick(event)"
    >
        {{ block.settings.text | default: block.settings.page.title }}
    </button>
{% elsif has_bra_tag %}
    <!-- "bra" tag but not "sports bra" tag: Show view chart link -->
    <a
        id="ProductPopup-{{ block.id }}"
        class="product-popup-modal__link custom-sizechart_bra"
        onclick="handleAllBrasClickPopup(event)"
        data-main-sizes="{% assign main_sizes = '' %}{% for variant in product.variants %}{% assign size = variant.option1 %}{% assign main_size = size | remove: 'A' | remove: 'B' | remove: 'C' | remove: 'D' | remove: 'DD' %}{% if main_sizes contains main_size %}{% else %}{{ main_size }},{% assign main_sizes = main_sizes | append: main_size | append: ',' %}{% endif %}{% endfor %}"
        data-sub-sizes="{{ product.variants | map: 'option1' | join: ',' }}"
