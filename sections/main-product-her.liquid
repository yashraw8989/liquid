<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Close all panels on page load
    closeAllPanels();

    var acc = document.querySelectorAll('.accordion13');
    var i;

    // Open the first accordion panel on page load
    if (acc.length > 0) {
     // acc[0].classList.add('wactive');
      var firstPanel = acc[0].nextElementSibling;
      //firstPanel.style.display = 'block';
      //acc[0].querySelector('.sp_plus').style.display = 'none';
      //acc[0].querySelector('.sp_minus').style.display = 'inline-block';
    }

    for (i = 0; i < acc.length; i++) {
      acc[i].addEventListener('click', function() {
        var isActive = this.classList.contains('active');

        // Close all accordion panels
        closeAllPanels();

        // Toggle active class and display state
        if (!isActive) {
          this.classList.toggle('active');
          var panel = this.nextElementSibling;
          panel.style.display = 'block';
          this.querySelector('.sp_plus').style.display = 'none';
          this.querySelector('.sp_minus').style.display = 'inline-block';
        }
      });
    }
  });

  function closeAllPanels() {
    var panels = document.querySelectorAll('.panel');
    for (var j = 0; j < panels.length; j++) {
      panels[j].style.display = 'none';
      var accordionButton = panels[j].previousElementSibling;
      accordionButton.classList.remove('active');
      accordionButton.querySelector('.sp_plus').style.display = 'inline-block';
      accordionButton.querySelector('.sp_minus').style.display = 'none';
    }
  }
</script>

