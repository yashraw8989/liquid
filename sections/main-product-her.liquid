<!-- Add this script to handle the variant selection and update the hidden fields -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Function to update hidden input field for selected variant
    function updateSelectedVariant(variantId) {
      const variantInput = document.querySelector('input[name="id"]');
      if (variantInput) {
        variantInput.value = variantId;
      }
    }

    // Add event listeners to variant swatches
    var swatches = document.querySelectorAll('.variant-swatch__item');
    swatches.forEach(function(swatch) {
      swatch.addEventListener('click', function() {
        if (this.classList.contains('disabled')) return;

        var variantId = this.getAttribute('data-variant-id');
        updateSelectedVariant(variantId);
      });
    });

    // Function to handle adding to cart and checkout
    function addCartCheckout(el) {
      // Select the form for adding to cart
      let form = document.querySelector('form[action="/cart/add"]');
      // Create a FormData object from the form
      let formData = new FormData(form);

      // Send a POST request to add the product to the cart
      fetch('/cart/add', {
        method: 'POST',
        body: formData
      })
      .then(function(response) {
        if (response.ok) {
          // If the request is successful, redirect to the checkout page
          location.href = '/checkout';
          return response.json();
        }
        // If the response is not okay, throw an error
        throw response;
      })
      .then(function(data) {
        // Log the response data to the console
        console.log(data);
      })
      .catch(function(error) {
        // Catch and log any errors that occur during the request
        console.warn(error);
      });
    }

    // Add event listener to the buy now button
    document.getElementById('buy-now-button').addEventListener('click', function() {
      // Call the addCartCheckout function when the button is clicked
      addCartCheckout(this);
    });
  });
</script>

