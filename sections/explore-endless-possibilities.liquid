      "default": "#1D1729"
    },

    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button Hover Text Color",
      "default": "#fe0008"
    },
        {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Color",
      "default": "#9be2f2"
    }
  ],
  "presets": [
    {
      "name": "Endless Possibilities"
    }
  ]
}

{% endschema %}