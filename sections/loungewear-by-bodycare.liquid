<style>
    .long-font {
      font-size: {{ section.settings.heading_font_size | default: '7' }}rem;
      text-transform: uppercase;
      font-weight: {{ section.settings.heading_font_weight | default: '800' }};
      color: {{ section.settings.heading_color | default: '#fe0008' }};
    }
    .text-p {
      text-transform: capitalize;
      font-size: {{ section.settings.paragraph_font_size | default: '16' }}px;
      text-align:center;
    }
        .dyn-btn-four {
      font-size: {{ section.settings.button_font_size | default: '22' }}px;
      font-style: normal;
      font-weight: {{ section.settings.button_font_weight | default: '600' }};
      background-color: {{ section.settings.button_bg_color }};
      color: {{ section.settings.button_text_color }};
    }
      .dyn-btn-four:hover {
      color: {{ section.settings.button_hover_text_color }};
    }
  .dyn-btn-four::before {
      background: {{ section.settings.button_hover_color }};
  }
</style>

{% comment %}
  This is a Shopify section for displaying a text block and images side by side.
{% endcomment %}

<section class="pad-120-tb pad-left-right loungewear">
  <div class="container-fluid pad-lr-0">
    <div class="row">
      <div class="col-lg-12">
        <div class="row">
          <div class="col-lg-7 col-md-6 disply-flexbox">
            <div class="imd-text-another">
              <h1 class="long-font">{{ section.settings.heading }}</h1>
              <p class="text-p">{{ section.settings.paragraph }}</p>
              <div class="cta__content-4 text-anim text-center mt-20">
                <a
                  rel="noreferrer"
                  href="{{ section.settings.button_link }}"
                  target="_blank"
                  class="nionx-btn nionx-btn--base shop_btn dyn-btn-four"
                  ><span>{{ section.settings.button_text }}</span></a
                >
              </div>
            </div>
          </div>
          <div class="col-lg-4 offset-lg-1 col-md-6">
            <div class="images">
              <div class="image">
                <img src="{{ section.settings.image_one | img_url: 'master' }}" width="100%" alt="Image 1">
                <img
                  class="first"
                  src="{{ section.settings.image_two | img_url: 'master' }}"
                  width="100%"
                  alt="Image 2"
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Loungewear By Bodycare",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loungewear by bodycare"
    },
    {
      "type": "number",
      "id": "heading_font_size",
      "label": "Heading Font Size (rem)",
      "default": 7
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#fe0008"
    },
    {
      "type": "number",
      "id": "heading_font_weight",
      "label": "Heading Font Weight",
      "default": 800
    },
    {
      "type": "number",
      "id": "paragraph_font_size",
      "label": "Paragraph Font Size (px)",
      "default": 16
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "elevate your every moment with luxe loungewear, where comfort, style and serenity merge seamlessly"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
            {
      "type": "number",
      "id": "button_font_size",
      "label": "Button Font Size (px)",
      "default": 22
    },
    {
      "type": "number",
      "id": "button_font_weight",
      "label": "Button Font Weight",
      "default": 600
    },
        {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#FE0008"
    },
        {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
        {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button Hover Text Color",
      "default": "#fe0008"
    },
        {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Color",
      "default": "#9be2f2"
    },
    {
      "type": "image_picker",
      "id": "image_one",
      "label": "Upload Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_two",
      "label": "Upload Image 2"
    }
  ],
  "presets": [
    {
      "name": "Loungewear By Bodycare",
      "category": "Text and image"
    }
  ]
}
{% endschema %}
