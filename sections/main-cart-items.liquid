    });
  }

  function updateTotalPrice(cartData) {
    cartData.items.forEach(item => {
      const itemRow = document.querySelector(`#CartItem-${item.id}`);
      const itemTotal = itemRow.querySelector('.cart-item__totals .price');

      if (itemTotal) {
        itemTotal.textContent = Shopify.formatMoney(item.final_line_price);
      }
    });

    // Update the overall cart total
    const cartTotal = document.querySelector('.totals__total-value');
    cartTotal.textContent = Shopify.formatMoney(cartData.total_price);
  }
</script>
