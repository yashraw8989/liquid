}
{% endschema %}
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>

<ul class="color-info" style="display:none;">
  {% for item in cart.items %}
  <li class="cart-item-data" 
      id="CartItemInfo-{{ item.key }}" 
      data-product-handle="{{ item.product.handle }}" 
      data-product-color="{% if item.product.metafields.custom.product_color_name %}{{ item.product.metafields.custom.product_color_name.value }}{% else %}unknown{% endif %}"
      data-product-sku="{{ item.sku }}" 
      data-product-variant-id="{{ item.variant_id }}"
      data-line-item-key="{{ item.key }}"
      data-product-price="{{ item.final_line_price }}" 
      data-product-type="{% if item.final_price == 0 %}free{% else %}paid{% endif %}"
      data-product-quantity="{{ item.quantity }}"
      data-b2g1="{% if item.product.tags contains 'buy 2 get 1 free' %}true{% else %}false{% endif %}">
  </li>
  {% endfor %}
</ul>

{%- assign b2g1_products_in_cart = false -%}
{%- assign has_zero_price_item_liquid = false -%}
{%- for item in cart.items -%}
  {%- if item.product.tags contains 'buy 2 get 1 free' -%}
    {%- assign b2g1_products_in_cart = true -%}
  {%- endif -%}
  {%- if item.final_price == 0 -%}
    {%- assign has_zero_price_item_liquid = true -%}
  {%- endif -%}
{%- endfor -%}

{% if b2g1_products_in_cart and has_zero_price_item_liquid == false %}
  <div class="b2g1-progress cart-progress">
    <span class="close-progress">&times;</span>
    <div class="progress-container">
      <div class="progress-header">
        <h3>Buy 2 Get 1 Free Progress</h3>
        <span class="item-count">0/3 items</span>
      </div>
      <div class="progress-bar-container">
        <div class="progress-bar" style="width: 0%;">&nbsp;</div>
      </div>
      <p class="progress-message"> You're almost there! Add a total of 3 items from this page to avail this offer.</p>
      <p class='tc' style='font-size: small;line-height:1.7;'>*Buy 2 Get 1 Free offer does not allow the same product to appear more than twice. Please choose a different variant or product to avail this offer.</p>
    </div>
  </div>
{% endif %}

<div id="product-details-modal" class="product-modal" style="display:none;">
  <span id="product-details-close">&times;</span>
  <div id="product-details-content"></div>
</div>

<div id="gift-selection-modal" class="gift-main-box" style="display:none;">
  <div class="product-gift-popup">
    <div class="close-btn5" id="freebie-close-btn">X</div>
    <h2 class="gift-title">Select Your Free Gift</h2>
    <div class="product-gift">
      <div class="pro1">
        <div class="pro-gift-img1">
          <img id="gift1-img" src="https://cdn.shopify.com/s/files/1/0652/5383/4910/files/XTACY.jpg?v=1731666725" alt="Gift 1 Image">
        </div>
        <div class="gift-box-text">
          <h3 id="gift1-name">BodyX Unisex Deodorant XTACY Deo 150ML</h3>
          <button id="gift1-btn" class="gift-btn">Add to Cart</button>
        </div>
      </div>
      <div class="pro1">
        <div class="pro-gift-img1">
          <img id="gift2-img" src="https://cdn.shopify.com/s/files/1/0652/5383/4910/files/XPRESSION.jpg?v=1731666785" alt="Gift 2 Image">
        </div>
        <div class="gift-box-text">
          <h3 id="gift2-name">BodyX Unisex Deodorant XPRESSION Deo 150ML</h3>
          <button id="gift2-btn" class="gift-btn">Add to Cart</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // --- B2G1 Progress Bar State & Logic ---
  let progressBarClosed = false;
  let offerComplete = false;

  function initializeB2G1ProgressClose() {
    const closeProgressBtn = document.querySelector('.b2g1-progress .close-progress');
    if (closeProgressBtn) {
      closeProgressBtn.addEventListener('click', function() {
        const progressContainer = this.closest('.b2g1-progress');
        if (progressContainer) {
          progressContainer.style.display = 'none';
          progressBarClosed = true;
        }
      });
    }
  }

  async function removeProductFromCart(lineItemKey) {
    try {
      const response = await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: lineItemKey, quantity: 0 }) 
      });
      return response.ok;
    } catch (error) {
      console.error('Error in removeProductFromCart:', error);
      return false;
    }
  }

  async function enforceB2g1Rules() {
    const cartItemDataElements = document.querySelectorAll('.color-info .cart-item-data');
    const skuMap = {};
    let productRemoved = false;
    let isB2G1OfferActive = false;

    cartItemDataElements.forEach(item => {
      const sku = item.dataset.productSku;
      const quantity = parseInt(item.dataset.productQuantity) || 0;
      const type = item.dataset.productType;
      const lineItemKey = item.dataset.lineItemKey;
      
      if (!sku || !lineItemKey) return;

      if (!skuMap[sku]) skuMap[sku] = { paidQuantity: 0, freeItems: [] };
      if (type === 'free') skuMap[sku].freeItems.push({ lineItemKey, quantity });
      else skuMap[sku].paidQuantity += quantity;
    });

    for (const sku in skuMap) {
      const { paidQuantity, freeItems } = skuMap[sku];
      const freeQuantity = freeItems.reduce((sum, item) => sum + item.quantity, 0);
      
      if (freeItems.length > 0 && (paidQuantity + freeQuantity) > 2) {
        for (const freeItem of freeItems) {
          if (await removeProductFromCart(freeItem.lineItemKey)) productRemoved = true;
        }
      }
      if (freeItems.length > 0 && (paidQuantity + freeQuantity) <= 2 && paidQuantity >= freeQuantity * 2) { 
        isB2G1OfferActive = true; 
      }
    }

    if (isB2G1OfferActive) sessionStorage.setItem('b2g1Active', 'true');
    else sessionStorage.removeItem('b2g1Active');

    if (productRemoved) {
      sessionStorage.setItem('showB2G1ViolationPopup', 'true'); 
      location.reload();
    }
  }  
  
  function updateB2G1ProgressBar() {
    if (progressBarClosed) return;

    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        const b2g1DataItems = Array.from(document.querySelectorAll('.color-info .cart-item-data[data-b2g1="true"]'));
        const progressContainer = document.querySelector('.b2g1-progress');
        const freebieModalElement = document.getElementById('gift-selection-modal');

        if (!progressContainer) return;

        const freebieModalVisible = freebieModalElement && window.getComputedStyle(freebieModalElement).display !== 'none';
        const hasAnyFreeItemInCart = cart.items.some(item => item.final_price === 0); 
        const isB2G1SessionActive = sessionStorage.getItem('b2g1Active') === 'true';

        if (freebieModalVisible || b2g1DataItems.length === 0 || (hasAnyFreeItemInCart && !isB2G1SessionActive) ) {
          progressContainer.style.display = 'none';
          return;
        } else {
          progressContainer.style.display = 'block';
        }

        let qualifyingCount = b2g1DataItems.reduce((acc, item) => {
            return acc + (parseInt(item.dataset.productQuantity) || 0);
        }, 0);
        
        const displayedCount = Math.min(qualifyingCount, 3); 

        const progressBar = progressContainer.querySelector('.progress-bar');
        const itemCountEl = progressContainer.querySelector('.item-count');
        const messageEl = progressContainer.querySelector('.progress-message');

        if (!progressBar || !itemCountEl || !messageEl) return;

        let percent = Math.min((displayedCount / 3) * 100, 100);
        progressBar.style.width = `${percent}%`;
        progressBar.textContent = displayedCount >= 3 ? "✓" : "";
        itemCountEl.textContent = `${displayedCount}/3 items`;

        if (displayedCount < 3) {
          const remaining = 3 - displayedCount;
          messageEl.innerHTML = `You're almost there! Add ${remaining} more ${remaining === 1 ? 'item' : 'items'} from the <a href="/collections/buy-2-get-1-free" style="color:red; text-decoration:underline;">Buy 2 Get 1 Free page</a> to avail this offer.`;
          progressBar.classList.remove('complete');
          offerComplete = false;
        } else {
          messageEl.textContent = "Congratulations! You've unlocked the Buy 2 Get 1 Free offer!";
          progressBar.classList.add('complete');
          if (!offerComplete && typeof confetti === 'function') {
            confetti({ particleCount: 150, spread: 70, origin: { y: 0.9 } });
            offerComplete = true;
          }
        }
      })
      .catch(error => console.error("Error updating B2G1 progress bar:", error));
  }

  function initializeViolationPopup() {
    if (sessionStorage.getItem('showB2G1ViolationPopup') === 'true') {
      sessionStorage.removeItem('showB2G1ViolationPopup');
      const popupHTML = `
        <div id="cart-violation-popup" class="cart-popup" style="display:block;">
          <span class="close-btn" style="cursor:pointer; font-size:20px; position:absolute; top:10px; right:15px;">&times;</span>
          <p>A free item from the "Buy 2 Get 1 Free" offer was adjusted as the conditions were no longer met. Please ensure you have the correct paid items to receive the free one.</p>
        </div>`;
      document.body.insertAdjacentHTML('beforeend', popupHTML);
      const popup = document.getElementById('cart-violation-popup');
      if (popup) {
        popup.querySelector('.close-btn').addEventListener('click', () => popup.remove()); 
      }
    }
  }

  // --- Freebie Gift Modal Logic (Using Pre-loaded Data) ---
  const FREEBIE_ELIGIBILITY_THRESHOLD_CENTS = 100000; 
  // Using handles now, as they are keys in window.freebieProductData
  const freeGiftProductHandles = [ 
    'bodyx-unisex-deodorant-xtacy-deo-150ml',
    'bodyx-unisex-deodorant-xpression-deo-150ml'
  ];
  let freebiePopupManuallyClosedThisPageLoad = false; 

  /**
  * Uses pre-loaded product data (from Liquid) to check stock and update modal.
  * Returns true if product is available and displayed, false otherwise.
  */
 // REPLACE the existing processFreebieProductFromPreloadedData function with this one:
// REPLACE the existing processFreebieProductFromPreloadedData function 
// in your main JavaScript block with this one:

async function processFreebieProductFromPreloadedData(productHandle, imgId, nameId, buttonId) {
    console.log(`Freebie Setup (Liquid): Processing data for ${productHandle}`);
    
    const imgEl = document.getElementById(imgId);
    const nameEl = document.getElementById(nameId);
    const buttonEl = document.getElementById(buttonId);
    let giftContainer = null;

    for (const el of [imgEl, nameEl, buttonEl]) {
      if (el) { giftContainer = el.closest('.pro1'); break; }
    }

    if (!giftContainer) {
      console.warn(`Freebie Setup (Liquid): Could not find .pro1 container for ${productHandle}. Cannot display this gift.`);
      return false;
    }
    giftContainer.style.display = 'none'; // Hide initially

    const product = (window.freebieProductData && window.freebieProductData[productHandle]) 
                    ? window.freebieProductData[productHandle] 
                    : null;

    if (!product) {
        console.error(`Freebie Setup (Liquid): Pre-loaded product data NOT FOUND for handle: ${productHandle}. Ensure Liquid pre-loading script is correct and runs before this.`);
        return false;
    }
    if (product === null) { 
        console.error(`Freebie Setup (Liquid): Product with handle '${productHandle}' was NULL in pre-loaded data (Liquid couldn't find all_products['${productHandle}']).`);
        return false;
    }
    if (!product.variants || product.variants.length === 0) {
        console.error(`Freebie Setup (Liquid): No variants found in pre-loaded data for ${product.title || productHandle}.`);
        return false;
    }

    let isActuallyAvailable = false;
    const firstVariant = product.variants[0]; 

    if (typeof firstVariant.available === 'boolean') {
        isActuallyAvailable = firstVariant.available;
    } else if (typeof product.available === 'boolean') {
        isActuallyAvailable = product.available;
        console.warn(`Stock Check (Liquid Data): ${product.title || productHandle} - variant.available missing, using product.available = ${isActuallyAvailable}`);
    } else if (firstVariant.inventory_management === 'shopify') {
        if (firstVariant.inventory_policy === 'continue') {
            isActuallyAvailable = true;
        } else if (typeof firstVariant.inventory_quantity === 'number') {
            isActuallyAvailable = firstVariant.inventory_quantity > 0;
        } else {
            console.warn(`Stock Check (Liquid Data): ${product.title || productHandle} - Shopify managed, but critical inventory details missing. Assuming unavailable.`);
            isActuallyAvailable = false; 
        }
    } else { 
        console.warn(`Stock Check (Liquid Data): ${product.title || productHandle} - No clear Shopify availability data. Assuming unavailable for safety.`);
        isActuallyAvailable = false;
    }
    
    console.log(`Freebie Setup (Liquid): ${product.title || productHandle}, Final Determined Available: ${isActuallyAvailable}`);

    if (!isActuallyAvailable) {
        return false;
    }

    // --- Update UI ---
    let imgSrc = '';

    // **MODIFICATION: Use static URL for XTACY Deo**
    if (productHandle === 'bodyx-unisex-deodorant-xtacy-deo-150ml') {
        imgSrc = 'https://ebodycare.in/cdn/shop/files/Xtacy_ccd1ef4b-ebad-4f20-8d66-2549c78fc5ed_1440x.jpg?v=1745215338';
        console.log(`Freebie Debug (Image): Using STATIC URL for ${productHandle}: ${imgSrc}`);
    } else {
        // Dynamic image sourcing for other products (e.g., XPRESSION Deo)
        if (product.images && product.images.length > 0 && product.images[0] && product.images[0].src) {
            imgSrc = product.images[0].src;
            console.log(`Freebie Debug (Image): Using product.images[0].src: ${imgSrc} for ${productHandle}`);
        } else if (product.featured_image && typeof product.featured_image === 'string' && product.featured_image.startsWith('http')) {
            imgSrc = product.featured_image;
            console.log(`Freebie Debug (Image): Using product.featured_image (string URL): ${imgSrc} for ${productHandle}`);
        } else {
            console.warn(`Freebie Debug (Image): No suitable dynamic image source found in pre-loaded data for ${productHandle}. Images array:`, product.images, "Featured image:", product.featured_image);
        }
    }

    if(imgEl) {
        if (imgSrc) {
            imgEl.src = imgSrc;
            imgEl.alt = product.title || productHandle || 'Free Gift Image';
        } else {
            imgEl.src = ''; 
            imgEl.alt = 'Image not available';
            console.warn(`Freebie Debug (Image): No imgSrc determined for ${productHandle}. Clearing image.`);
        }
    } else {
        console.warn(`Freebie Debug (Image): imgEl (id: ${imgId}) not found in DOM for ${productHandle}.`);
    }

    if (nameEl) nameEl.textContent = product.title || productHandle;

    if (buttonEl && firstVariant) {
        buttonEl.disabled = false;
        buttonEl.textContent = 'Add to Cart';
        const newButtonEl = buttonEl.cloneNode(true);
        buttonEl.parentNode.replaceChild(newButtonEl, buttonEl);
        newButtonEl.addEventListener('click', () => {
            addSelectedFreeGiftToCart(firstVariant.id); 
            const modal = document.getElementById('gift-selection-modal');
            if (modal) modal.style.display = 'none';
        });
    } else if (buttonEl) {
        buttonEl.disabled = true;
        buttonEl.textContent = 'Unavailable';
    }

    if (giftContainer) giftContainer.style.display = ''; 
    console.log(`Freebie Setup (Liquid): ${product.title || productHandle} is available and displayed.`);
    return true;
  }

  async function showFreebieModal() {
    if (freebiePopupManuallyClosedThisPageLoad) {
      // console.log("Freebie Modal: Already closed by user, not showing");
      return;
    }

    const modal = document.getElementById('gift-selection-modal');
    if (!modal) {
      console.error("Freebie Modal: Modal element not found");
      return;
    }
    // console.log("Freebie Modal: Checking gift availability using pre-loaded data...");

    const availabilityPromises = [
      processFreebieProductFromPreloadedData(freeGiftProductHandles[0], 'gift1-img', 'gift1-name', 'gift1-btn'),
      processFreebieProductFromPreloadedData(freeGiftProductHandles[1], 'gift2-img', 'gift2-name', 'gift2-btn')
    ];

    try {
      const results = await Promise.all(availabilityPromises);
      const availableGiftsCount = results.filter(Boolean).length;
      
      console.log(`Freebie Modal: ${availableGiftsCount} gift(s) available after stock check (using pre-loaded data).`);

      if (availableGiftsCount > 0) {
        modal.style.display = 'block';
        const closeButton = document.getElementById('freebie-close-btn');
        if (closeButton) {
          const newCloseButton = closeButton.cloneNode(true);
          closeButton.parentNode.replaceChild(newCloseButton, closeButton);
          newCloseButton.addEventListener('click', () => {
            modal.style.display = 'none';
            freebiePopupManuallyClosedThisPageLoad = true;
            // console.log("Freebie Modal: Closed by user");
          });
        }
        // console.log("Freebie Modal: Displayed successfully (using pre-loaded data)");
      } else {
        // console.log("Freebie Modal: No gifts available to display, modal not shown (using pre-loaded data)");
        modal.style.display = 'none';
      }
    } catch (error) {
      console.error("Freebie Modal: Error checking gift availability (using pre-loaded data):", error);
      modal.style.display = 'none';
    }
  }

  function addSelectedFreeGiftToCart(variantId) {
    // console.log(`Adding free gift variant ${variantId} to cart`);
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: variantId, quantity: 1, properties: { _isFreeGift: true } }] })
    })
    .then(response => {
      if (response.ok) { location.reload(); } 
      else { console.error('Failed to add free gift to cart'); }
    })
    .catch(error => { console.error('Error adding free gift to cart:', error); });
  }

  async function checkFreebieEligibility() {
    const freebieModal = document.getElementById('gift-selection-modal');
    if (!freebieModal) return;

    const b2g1IsActive = sessionStorage.getItem('b2g1Active') === 'true';
    if (b2g1IsActive || freebiePopupManuallyClosedThisPageLoad) {
      freebieModal.style.display = 'none';
      return;
    }

    try {
      const cartResponse = await fetch('/cart.js'); // Still need cart data for eligibility
      const cart = await cartResponse.json();

      const hasExistingFreeGift = cart.items.some(item => 
        window.freebieProductData && Object.values(window.freebieProductData).some(pData => pData && pData.variants && pData.variants.some(v => v.id === item.variant_id)) && item.final_price === 0
        // More robust check using preloaded data if item.url isn't reliable for freebies
        // Or simplify: freeGiftProductHandles.some(handle => item.handle === handle && item.final_price === 0) // if item.handle is available
      );
      // Simpler check if item.url still points to the product handle in freeGiftProductHandles
      const hasExistingFreeGiftSimple = cart.items.some(item => 
        freeGiftProductHandles.some(handle => item.url?.includes(handle)) && item.final_price === 0
      );


      if (hasExistingFreeGiftSimple) { // Using simpler check for now
        freebieModal.style.display = 'none';
        return;
      }

      let totalEligiblePriceCents = 0;
      for (const item of cart.items) {
        // To check 'freebie popup' tag, we still need to fetch or have tags pre-loaded for *cart items*
        // This part is tricky without fetching each cart item's full data
        // Assuming for now, any item contributes if we cannot easily check tags without more fetches
        // For a more accurate totalEligiblePrice, tags for cart items would be needed.
        // Let's use a simplified approach: assume all items in cart (not freebies themselves) contribute if we can't check tags easily.
        // OR, fetch product data for cart items if essential.
        // The original code fetched product data for cart items, let's retain that for tag checking:

        const productHandle = item.handle;
        try { // This fetch is for cart items to check their 'freebie popup' tag
          const productResponse = await fetch(`/products/${productHandle}.json`);
          if (productResponse.ok) {
            const productData = await productResponse.json();
            if (productData.product?.tags?.includes('freebie popup')) {
              totalEligiblePriceCents += item.final_line_price;
            }
          }
        } catch (error) {
          // console.warn(`Could not fetch product details for cart item ${productHandle} during eligibility:`, error);
        }
      }
      // console.log(`Freebie Eligibility: Total eligible amount: ${totalEligiblePriceCents} cents (threshold: ${FREEBIE_ELIGIBILITY_THRESHOLD_CENTS})`);

      if (totalEligiblePriceCents >= FREEBIE_ELIGIBILITY_THRESHOLD_CENTS) {
        await showFreebieModal(); 
      } else {
        freebieModal.style.display = 'none';
      }
    } catch (error) {
      console.error('Error checking freebie eligibility:', error);
      if (freebieModal) freebieModal.style.display = 'none';
    }
  }

  // --- General Initializers & Listeners for other functionalities ---
  function initializeQuantityChangeListeners() {
    document.querySelectorAll('.quantity__button, quantity-input .quantity__input').forEach(element => {
      const eventType = element.tagName.toLowerCase() === 'input' ? 'change' : 'click';
      element.addEventListener(eventType, function() {
        setTimeout(() => {
          enforceB2g1Rules().then(() => location.reload()); 
        }, 700); 
      });
    });
  }

  function initializeRemoveButtonListeners() {
      document.querySelectorAll('cart-remove-button a.button--tertiary').forEach(button => {
          button.addEventListener('click', function (event) {
              event.preventDefault();
              const urlToRemove = this.getAttribute('href'); 
              if (urlToRemove) {
                  fetch(urlToRemove, { method: 'GET' }) 
                      .then(() => location.reload())
                      .catch(() => location.reload()); 
              }
          });
      });
  }
  
  // --- Initial Calls & Periodic Checks ---
  initializeB2G1ProgressClose();
  initializeViolationPopup();

  // Ensure pre-loaded data is available before proceeding
  if (window.freebieProductData) {
    enforceB2g1Rules().then(() => { 
      updateB2G1ProgressBar(); 
      checkFreebieEligibility(); 
    });

    setInterval(() => { 
      updateB2G1ProgressBar();
      checkFreebieEligibility();
    }, 6000); 
  } else {
    console.error("Freebie product data not pre-loaded. Freebie modal may not function correctly.");
    // Fallback or just let B2G1 run
    enforceB2g1Rules().then(updateB2G1ProgressBar);
    setInterval(updateB2G1ProgressBar, 6000);
  }

});
</script>