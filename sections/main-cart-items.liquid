{% comment %} --- START: Pre-load Freebie Product Data for JavaScript (Add this to your cart.liquid or relevant template) --- {% endcomment %}
{%- assign freebie_handle_1 = 'bodyx-unisex-deodorant-xtacy-deo-150ml' -%}
{%- assign freebie_handle_2 = 'bodyx-unisex-deodorant-xpression-deo-150ml' -%}

{%- assign freebie_product_1_obj = all_products[freebie_handle_1] -%}
{%- assign freebie_product_2_obj = all_products[freebie_handle_2] -%}

<script id="freebieProductDataScript">
  window.freebieProductData = {
    {% if freebie_product_1_obj %}
      '{{ freebie_handle_1 }}': {{ freebie_product_1_obj | json }},
    {% else %}
      '{{ freebie_handle_1 }}': null,
    {% endif %}
    {% if freebie_product_2_obj %}
      '{{ freebie_handle_2 }}': {{ freebie_product_2_obj | json }}
    {% else %}
      '{{ freebie_handle_2 }}': null,
    {% endif %}
  };
  // For debugging in your browser console:
  // console.log("Pre-loaded Freebie Product Data:", JSON.parse(JSON.stringify(window.freebieProductData)));
</script>
{% comment %} --- END: Pre-load Freebie Product Data --- {% endcomment %}


<cart-items class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="page-width int-title-head">
    <div class="title-wrapper-with-link">
      <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
        {{- 'general.continue_shopping' | t -}}
      </a>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="login-n-btn2">
        {{ 'general.continue_shopping' | t }}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="mcart-cartf-wrapped">
        <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
          <div class="js-contents">
            {%- if cart != empty -%}
              <table class="cart-items">
                <caption class="visually-hidden">
                  {{ 'sections.cart.title' | t }}
                </caption>
                <thead>
                  <tr>
                    <th class="caption-with-letter-spacing" colspan="2" scope="col">
                      {{ 'sections.cart.headings.product' | t }}
                    </th>
                    <th class="medium-hide large-up-hide right caption-with-letter-spacing" colspan="1" scope="col">
                      {{ 'sections.cart.headings.total' | t }}
                    </th>
                    <th
                      class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing"
                      colspan="1"
                      scope="col"
                    >
                      {{ 'sections.cart.headings.quantity' | t }}
                    </th>
                    <th class="custom-final-price-per-item">Price</th>
                    <th class="small-hide right caption-with-letter-spacing" colspan="1" scope="col">
                      {{ 'sections.cart.headings.total' | t }}
                    </th>
                  </tr>
                </thead>
              </table>
              <ul>
                {%- for item in cart.items -%}
                  <li class="cart-item custom-cart-page" id="CartItem-{{ item.index | plus: 1 }}">
                    <div class="custom-cart-p-details">
                      <div class="cart-item__media dd">
                        {% if item.image %}
                          <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                          <div class="cart-item__image-container gradient global-media-settings">
                            <img
                              src="{{ item.image | image_url: width: 300 }}"
                              class="cart-item__image"
                              alt="{{ item.image.alt | escape }}"
                              loading="lazy"
                              width="150"
                              height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                            >
                          </div>
                        {% endif %}
                      </div>

                      <div class="cart-item__details">
                        {%- if settings.show_vendor -%}
                          <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                        {%- endif -%}

                        <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>

                        {% assign compare_price = item.variant.compare_at_price %}
                        {% assign final_price = item.final_price %}
                        
                        {%- if compare_price and compare_price > final_price -%}
                          <div class="cart-item__discounted-prices" style="display: block;">
                            <span class="price-compare">
                              <span class="visually-hidden">
                                {{ 'products.product.price.regular_price' | t }}
                              </span>
                              <s class="cart-item__old-price product-option">
                                {{ compare_price | money }}
                              </s>
                              <span class="visually-hidden">
                                {{ 'products.product.price.sale_price' | t }}
                              </span>
                              <strong class="cart-item__final-price product-option">
                                {{ final_price | money }}
                              </strong>
                            </span>
                            {% assign discount_percentage = compare_price | minus: final_price | times: 100.0 | divided_by: compare_price %}
                            <span class="cart-item__discount-percentage">
                              {{ discount_percentage | round: 0 }}% off
                            </span>
                          </div>
                        {%- else -%}
                          <div class="cart-item__price">
                            <span class="price price--end">
                              {{ final_price | money }}
                            </span>
                          </div>
                        {%- endif %}

                        {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != null -%}
                          <dl>
                            {%- if item.product.has_only_default_variant == false -%}
                              {%- for option in item.options_with_values -%}
                                <div class="product-option">
                                  <dt>{{ option.name }}:</dt>
                                  <dd>{{ option.value }}</dd>
                                </div>
                              {%- endfor -%}
                            {%- endif -%}

                            {%- for property in item.properties -%}
                              {%- assign property_first_char = property.first | slice: 0 -%}
                              {%- if property.last != blank and property_first_char != '_' -%}
                                <div class="product-option">
                                  <dt>{{ property.first }}:</dt>
                                  <dd>
                                    {%- if property.last contains '/uploads/' -%}
                                      <a href="{{ property.last }}" class="link" target="_blank">
                                        {{ property.last | split: '/' | last }}
                                      </a>
                                    {%- else -%}
                                      {{ property.last }}
                                    {%- endif -%}
                                  </dd>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                          </dl>

                          {%- if item.selling_plan_allocation -%}
                            <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}
                        {%- endif -%}

                        <ul
                          class="discounts list-unstyled"
                          role="list"
                          aria-label="{{ 'customer.order.discount' | t }}"
                        >
                          {%- for discount in item.line_level_discount_allocations -%}
                            <li class="discounts__discount">
                              {%- render 'icon-discount' -%}
                              {{ discount.discount_application.title }}
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    </div>

                    <div class="cart-item__totals right medium-hide large-up-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {% if item.original_line_price != item.final_line_price %}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {% else %}
                          <span class="price price--end"> {{ item.original_line_price | money }} </span>
                        {% endif %}
                      </div>
                    </div>

                    <div class="cart-item__quantity{% if item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null or item.variant.quantity_rule.increment > 1 %} cart-item__quantity--info{% endif %}">
                      <quantity-popover>
                        <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                          <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                            {{ 'products.product.quantity.label' | t }}
                          </label>
                          <div class="quantity-popover-container{% if item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null or item.variant.quantity_rule.increment > 1 %} quantity-popover-container--hover{% endif %}">
                            <quantity-input class="quantity cart-quantity">
                              <button class="quantity__button no-js-hidden" name="minus" type="button">
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                                </span>
                                {% render 'icon-minus' %}
                              </button>
                              <input
                                class="quantity__input"
                                data-quantity-variant-id="{{ item.variant.id }}"
                                type="number"
                                name="updates[]"
                                value="{{ item.quantity }}"
                                {% # theme-check-disable %}
                                data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                min="{{ item.variant.quantity_rule.min | default: 1 }}"
                                {% if item.variant.quantity_rule.max != null %}
                                  max="{{ item.variant.quantity_rule.max }}"
                                {% endif %}
                                step="{{ item.variant.quantity_rule.increment | default: 1 }}"
                                {% # theme-check-enable %}
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                id="Quantity-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                              >
                              <button class="quantity__button no-js-hidden" name="plus" type="button">
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                                </span>
                                {% render 'icon-plus' %}
                              </button>
                            </quantity-input>
                          </div>
                          <cart-remove-button
                            id="Remove-{{ item.index | plus: 1 }}"
                            data-index="{{ item.index | plus: 1 }}"
                          >
                            <a
                              href="{{ item.url_to_remove }}"
                              class="button button--tertiary"
                              aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
                            >
                              {% render 'icon-remove' %}
                            </a>
                          </cart-remove-button>
                        </div>
                      </quantity-popover>
                    </div>

                    {% if compare_price and compare_price > final_price %}
                      <span class="discouned-custom-div " style="display: block; text-align: right; padding-right: 15px; text-decoration:line-through;" >
                        {{- compare_price | times: item.quantity | money -}}
                      </span>
                    {% else %}
                      <div class="single-item-price" style="display: block; text-align: right; padding-right: 15px;">{{ item.original_price | times: item.quantity | money }}</div>
                    {% endif %}

                    <div class="cart-item__totals right small-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {% if item.original_line_price != item.final_line_price %}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {% else %}
                          <span class="price price--end">
                            {{ item.original_line_price | money }}
                          </span>
                        {% endif %}
                      </div>
                    </div>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      </div>
      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>

<script>
  // Quantity AJAX update script
  document.addEventListener('DOMContentLoaded', function () {
    const quantityInputs = document.querySelectorAll('quantity-input .quantity__input');

    quantityInputs.forEach(input => {
      input.addEventListener('change', function () {
        const variantId = this.dataset.quantityVariantId;
        const newQuantity = this.value;
        updateCartItemById(variantId, newQuantity);
      });
    });
  });

  function updateCartItemById(variantId, newQuantity) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: newQuantity })
    })
    .then(response => response.json())
    .then(cartData => {
      if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
        updateLiveTotals(cartData);
      }
    })
    .catch(error => {
      console.error('Error updating cart item via AJAX:', error);
    });
  }

 function updateLiveTotals(cartData) {
    cartData.items.forEach(item => {
        const itemRow = document.querySelector(`quantity-input input[data-quantity-variant-id="${item.id}"]`)?.closest('.cart-item');
        if (itemRow) {
            const priceWrapperMobile = itemRow.querySelector('.cart-item__totals.right.medium-hide.large-up-hide .cart-item__price-wrapper');
            const priceWrapperDesktop = itemRow.querySelector('.cart-item__totals.right.small-hide .cart-item__price-wrapper');
            [priceWrapperMobile, priceWrapperDesktop].forEach(pw => {
                if (pw) {
                    if (item.original_line_price !== item.final_line_price) {
                        pw.innerHTML = `
                            <dl class="cart-item__discounted-prices">
                                <dt class="visually-hidden">${ (typeof Shopify !== 'undefined' && Shopify.translation?.regular_price) || 'Regular price'}</dt>
                                <dd><s class="cart-item__old-price price price--end">${Shopify.formatMoney(item.original_line_price)}</s></dd>
                                <dt class="visually-hidden">${ (typeof Shopify !== 'undefined' && Shopify.translation?.sale_price) || 'Sale price'}</dt>
                                <dd class="price price--end">${Shopify.formatMoney(item.final_line_price)}</dd>
                            </dl>`;
                    } else {
                        pw.innerHTML = `<span class="price price--end">${Shopify.formatMoney(item.final_line_price)}</span>`;
                    }
                }
            });
        }
    });
    const subtotalElement = document.querySelector('.totals__subtotal-value, #CartSubtotal .money');
    if (subtotalElement) {
        subtotalElement.innerHTML = Shopify.formatMoney(cartData.total_price);
    }
}
</script>

<style>
  .cart-item-freebie .cart-item__quantity-wrapper.quantity-popover-wrapper {
    display: none;
  }
</style>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
