    fetch('/cart/change.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        id: itemId,
        quantity: newQuantity
      })
    })
    .then(response => response.json())
    .then(data => {
      // Update the total price on the page
      updateTotalPrice(data);
    })
    .catch(error => {
