<script>
document.addEventListener('DOMContentLoaded', function () {
  const freeGiftProductUrls = [
    '/products/bodyx-unisex-deodorant-xtacy-deo-150ml',
    '/products/bodyx-unisex-deodorant-xpression-deo-150ml'
  ];

  // Function to add the selected freebie to the cart
  function addSelectedGiftToCart(variantId) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: [
          {
            id: variantId, // The variant ID of the selected freebie
            quantity: 1 // Add 1 quantity of the freebie
          }
        ]
      })
    })
      .then(response => response.json())
      .then(data => {
        console.log('Free gift added successfully:', data);
        location.reload(); // Reload to reflect changes
      })
      .catch(error => console.error('Error adding free gift:', error));
  }

  // Function to fetch product data and update the modal with the gift options
  function fetchProductDataAndUpdateModal(productUrl, imgId, nameId, buttonId) {
    fetch(`${productUrl}.json`)
      .then(response => response.json())
      .then(productData => {
        const product = productData.product;
        const productImg = product.images[0].src;
        const productName = product.title;
        const variantId = product.variants[0].id; // Assuming first variant

        // Update the modal content
        document.getElementById(imgId).src = productImg;
        document.getElementById(nameId).innerText = productName;

        // Set button action to add gift to cart
        document.getElementById(buttonId).onclick = function () {
          addSelectedGiftToCart(variantId); // Add the selected freebie to the cart
          document.getElementById('gift-selection-modal').style.display = 'none'; // Close the modal
        };
      })
      .catch(error => console.error(`Error fetching product data for ${productUrl}:`, error));
  }

  // Function to check if a product with a duplicate color exists
  async function hasDuplicateColor(cartItems, freeGiftColor) {
    for (const item of cartItems) {
      const productColor = item.dataset.productColor; // Assuming color is exposed in HTML
      if (productColor === freeGiftColor) {
        return true; // Duplicate color found
      }
    }
    return false; // No duplicate color found
  }

  // Function to show the gift selection modal
  function showModal() {
    const modal = document.getElementById('gift-selection-modal');
    modal.style.display = 'block';

    // Fetch and update gift options for the modal
    fetchProductDataAndUpdateModal(freeGiftProductUrls[0], 'gift1-img', 'gift1-name', 'gift1-btn');
    fetchProductDataAndUpdateModal(freeGiftProductUrls[1], 'gift2-img', 'gift2-name', 'gift2-btn');

    // Close the modal when the close button is clicked
    document.querySelector('.close-btn5').onclick = function () {
      modal.style.display = 'none';
    };
  }

  // Function to check cart status and determine if the gift modal should be shown
  function checkCartStatus() {
    // ADDED: Check if B2G1 is active before proceeding
    if (sessionStorage.getItem('b2g1Active') === 'true') {
      console.log('B2G1 is active, skipping gift selection modal.');
      return; // ADDED: Stop here, do not show gift modal if B2G1 is active
    }

    fetch('/cart.js')
      .then(response => response.json())
      .then(async cart => {
        const hasFreeGift = cart.items.some(item => freeGiftProductUrls.some(url => item.url.includes(url)));
        if (!hasFreeGift) {
          let totalEligiblePrice = 0;

          const cartItems = document.querySelectorAll('.cart-item');

          for (const item of cart.items) {
            const productHandle = item.handle;

            // Fetch product data to determine eligibility
            await fetch(`/products/${productHandle}.json`)
              .then(response => response.json())
              .then(async productData => {
                const product = productData.product;
                const isEligible = product.tags.includes('freebie popup');
                const freeGiftColor = product.metafields?.custom?.product_color_name || '';

                if (isEligible) {
                  totalEligiblePrice += item.final_line_price;
                }

                // Show the modal if eligible spend is above threshold and no duplicate color
                if (totalEligiblePrice >= 1000 * 100) { // Adjust your threshold
                  const isDuplicate = await hasDuplicateColor(cartItems, freeGiftColor);

                  if (!isDuplicate) {
                    showModal();
                  } else {
                    console.log(`Skipping free gift due to duplicate color: ${freeGiftColor}`);
                  }
                }
              })
              .catch(error => console.error('Error fetching product data:', error));
          }
        }
      })
      .catch(error => console.error('Error fetching cart data:', error));
  }

  // Poll the cart every 5 seconds to check if the gift modal should be shown
  setInterval(checkCartStatus, 9000);

  // Initial check on page load
  //checkCartStatus();  <===== COMMENTED OUT THIS LINE

  // The Free Gift Modal polling logic (setInterval for checkCartStatus and its helper functions like 
  // addSelectedGiftToCart, fetchProductDataAndUpdateModal, hasDuplicateColor, showModal)
  // has been REMOVED from this inline script. Its functionality will be integrated into 
  // assets/b2g1-handler.js and triggered by the cart:updated event or after UI updates.
});
</script>
