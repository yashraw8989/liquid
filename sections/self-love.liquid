<style>
  .para-full-ax {
    background-image:url('{{ section.settings.image | img_url: ''}}');
  }

  .para-full-ax:hover {
     background-image:url('{{ section.settings.image | img_url: ''}}');
  }

    .para-full-mx {
    background-image:url('{{ section.settings.mobile_image | img_url: ''}}');
  }

  .para-full-mx:hover {
     background-image:url('{{ section.settings.mobile_image | img_url: ''}}');
  }
</style>


<section class="para-full-mx desktop-hide" >
  <div class="container-fluid">
    <div class="row">
      <div class="full-img-bck" data-aos="fade-up" data-aos-easing="linear" data-aos-duration="2000"
     data-aos-anchor-placement="center-bottom">
        <img src="" class="img-fluid img-responsive img-full" width="100%">
      </div>
     
    </div>
  </div>
</section>
<section class="para-full-ax mobile-hide" >
  <div class="container-fluid">
    <div class="row">
      <div class="full-img-bck" data-aos="fade-up" data-aos-easing="linear" data-aos-duration="2000"
     data-aos-anchor-placement="center-bottom">
        <img src="" class="img-fluid img-responsive img-full" width="100%">
      </div>
      <div class="row" style="z-index: -100; position: static; width: 100%;">
        <div class="col-lg-12">
          <div class="text-scroll">
            <h2>{{ section.settings.heading }}</h2>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lingerie Self Love",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
        {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lingerie for self love rituals"
    }
  ],
  "presets": [
    {
      "name": "Lingerie Self Love"
    }
  ]
}
{% endschema %}
