<section class="mar_blk1 desktop-hide">
  <div class="container-fluid pd-0">
    <div class="marquee">
      <div class="track1">
        <div class="conten1t">#Style That Moves With You #Style That Moves With You</div>
      </div>
    </div>
  </div>
</section>
<section class="pad-lr-0 pad-bottom-50" >
  <div class="container-fluid pad-lr-0">
    <div class="row">
      <div class="col-lg-12 mobile-hide"  data-aos="fade-down" data-aos-easing="linear" data-aos-duration="2000"
     data-aos-anchor-placement="center-bottom">
        <div class="bck-head">
          <h2>{{ section.settings.heading }}</h2>
        </div>
      </div>
      
      <div class="col-lg-12">
        <div class="row">
          <div class="col-lg-7 col-sm-7"  data-aos="fade-right" data-aos-easing="linear" data-aos-duration="2000"
     data-aos-anchor-placement="center-bottom">
            <div class="imd-div-2">
              <video width="100%" height="100%" autoplay="" muted="" playsinline=""  loop="">
                <source src="{{ section.settings.video_source }}" type="video/mp4">
              </video>
            </div>
          </div>
          <div class="col-lg-5 col-sm-5"  data-aos="fade-left" data-aos-easing="linear" data-aos-duration="2000"
     data-aos-anchor-placement="center-bottom">
            <div class="imd-div-2">
              <a href="{{ section.settings.button_link_onee }}"><img src="{{ section.settings.image_source | img_url: 'master' }}" class="img-fluid width-100 heightvhrt"></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Style That Moves With You",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STYLE THAT MOVES WITH YOU"
    },
    {
      "type": "url",
      "id": "video_source",
      "label": "Video Source URL"
    },
     {
      "type": "url",
      "id": "button_link_onee",
      "label": "Button Link URL"
    },
    {
      "type": "image_picker",
      "id": "image_source",
      "label": "Image Source"
    }
  ],
  "presets": [
    {
      "name": "Style That Moves With You"
    }
  ]
}
{% endschema %}