<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
                data-url="{{ link.url }}"
              >
                <span
                  {%- if link.child_active -%}
                    class="header__active-menu-item"
                  {%- endif -%}
                >
                  {{- link.title | escape -}}
                </span>
                {% render 'icon-caret' %}
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                <div class="wrapped-image">
                  {% if link.handle == 'men' %}
                    {% if section.settings.men_left_image_url != blank %}
                      <!-- Left Image -->
                      <div class="menu-image-left">
                        <img src="{{ section.settings.men_left_image_url | img_url: 'master' }}" alt="Left Image">
                      </div>
                    {% endif %}
                    {% if section.settings.men_below_left_image_url != blank %}
                      <div class="menu-image-left-below">
                        <img src="{{ section.settings.men_below_left_image_url | img_url: 'master' }}" alt="Left Image">
                      </div>
                    {% endif %}
                  {% endif %}
                  {% if link.handle == 'women' %}
                    {% if section.settings.women_left_image_url != blank %}
                      <!-- Left Image -->
                      <div class="menu-image-left">
                        <img src="{{ section.settings.women_left_image_url | img_url: 'master' }}" alt="Left Image">
                      </div>
                    {% endif %}
                    {% if section.settings.women_below_left_image_url != blank %}
                      <div class="menu-image-left-below">
                        <img
                          src="{{ section.settings.women_below_left_image_url | img_url: 'master' }}"
                          alt="Left Image"
                        >
                      </div>
                    {% endif %}
                  {% endif %}
                  {% if link.handle == 'athleisure' %}
                    {% if section.settings.athleisure_left_image_url != blank %}
                      <!-- Left Image -->
                      <div class="menu-image-left">
                        <img
                          src="{{ section.settings.athleisure_left_image_url | img_url: 'master' }}"
                          alt="Left Image"
                        >
                      </div>
                    {% endif %}
                    {% if section.settings.athleisure_below_left_image_url != blank %}
                      <div class="menu-image-left-below">
                        <img
                          src="{{ section.settings.athleisure_below_left_image_url | img_url: 'master' }}"
                          alt="Left Image"
                        >
                      </div>
                    {% endif %}
                  {% endif %}
                  {% if link.handle == 'offers' %}
                    {% if section.settings.offers_left_image_url != blank %}
                      <!-- Left Image -->
                      <div class="menu-image-left">
                        <img
                          src="{{ section.settings.offers_left_image_url | img_url: 'master' }}"
                          alt="Left Image"
                        >
                      </div>
                    {% endif %}
                    {% if section.settings.offers_below_left_image_url != blank %}
                      <div class="menu-image-left-below">
                        <img
                          src="{{ section.settings.offers_below_left_image_url | img_url: 'master' }}"
                          alt="Left Image"
                        >
                      </div>
                    {% endif %}
                  {% endif %}
                </div>
                <div class="menu-wrapped">
                  <div
                    class="mega-menu__list page-width{% if link.levels == 1 %} mega-menu__list--condensed{% endif %}{% if link.handle == 'women' %} women-class{% endif %}"
                    role="list"
                  >
                    {%- for childlink in link.links -%}
                      <ul>
                        <a
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          href="{{ childlink.url }}"
                          class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}"
                          {% if childlink.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ childlink.title | escape }}
                        </a>
                        {%- if childlink.links != blank -%}
                          <li class="list-unstyled" role="list">
                            {%- for grandchildlink in childlink.links -%}
                              <li>
                                <a
                                  id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                  href="{{ grandchildlink.url }}"
                                  class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}"
                                  {% if grandchildlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{ grandchildlink.title | escape }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </li>
                        {%- endif -%}
                      </ul>
                    {%- endfor -%}
                  </div>
                </div>
                {% if link.handle == 'men' %}
                  {% if section.settings.men_right_image_url != blank %}
                    <!-- Right Image -->
                    <div class="menu-image-right">
                      <img src="{{ section.settings.men_right_image_url | img_url: 'master' }}" alt="Right Image">
                    </div>
                  {% endif %}
                {% endif %}
                {% if link.handle == 'women' %}
                  {% if section.settings.women_right_image_url != blank %}
                    <!-- Right Image -->
                    <div class="menu-image-right">
                      <img src="{{ section.settings.women_right_image_url | img_url: 'master' }}" alt="Right Image">
                    </div>
                  {% endif %}
                {% endif %}
                {% if link.handle == 'athleisure' %}
                  {% if section.settings.athleisure_right_image_url != blank %}
                    <!-- Right Image -->
                    <div class="menu-image-right">
                      <img
                        src="{{ section.settings.athleisure_right_image_url | img_url: 'master' }}"
                        alt="Right Image"
                      >
                    </div>
                  {% endif %}
                {% endif %}
                {% if link.handle == 'offers' %}
                  {% if section.settings.offers_right_image_url != blank %}
                    <!-- Right Image -->
                    <div class="menu-image-right">
                      <img
                        src="{{ section.settings.offers_right_image_url | img_url: 'master' }}"
                        alt="Right Image"
                      >
                    </div>
                  {% endif %}
                {% endif %}
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current -%}
                class="header__active-menu-item"
              {%- endif -%}
            >
              {{- link.title | escape }}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const detailsElements = document.querySelectorAll(".mega-menu");

    detailsElements.forEach(details => {
      const summary = details.querySelector("summary");

      // Show menu on hover
      summary.addEventListener("mouseenter", function () {
        details.setAttribute("open", "");
      });

      // Redirect to link URL on click
      summary.addEventListener("click", function () {
        window.location.href = summary.getAttribute("data-url");
      });

      // Hide menu when mouse leaves the entire details element, but with a slight delay
      // to account for quick movements into the menu
      details.addEventListener("mouseleave", function () {
        setTimeout(() => {
          if (!details.matches(':hover')) {
            details.removeAttribute("open");
          }
        }, 200);
      });

      // Keep the menu open if mouse is over it
      details.addEventListener("mouseover", function () {
        details.setAttribute("open", "");
      });
    });
  });
</script>
