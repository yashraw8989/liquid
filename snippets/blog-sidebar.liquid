<!-- Top 5 Blog Posts Section -->
<div class="top-blogs">
  <h3>TOP 5 BLOG POSTS</h3>
  <div class="blog_posts">
    <ul>
      {% assign global_blog = blogs['blogs'] %} <!-- Replace 'blogs' with your blog handle -->
      {% if global_blog and global_blog.articles.size > 0 %}
        {% assign latest_articles = global_blog.articles | sort: "published_at" | reverse %}
        {% for article in latest_articles limit: 5 %}
          <li>
            <a href="{{ article.url }}">{{ article.title }}</a>
          </li>
        {% endfor %}
      {% else %}
        <li>No blog posts found</li>
      {% endif %}
    </ul>
  </div>
</div>

 
  <!-- Blog Tags Sidebar -->
<div class="blog-tags">
  <h3>TAGS</h3>
  <div class="tags_blogs">
    <ul>
          <li>
            <a href="/blogs/blogs/tagged/men">men</a>
          </li>
          <li>
            <a href="/blogs/blogs/tagged/woman">woman</a>
          </li>
          <li>
            <a href="/blogs/blogs/tagged/sports">sports</a>
          </li>
  </ul>
