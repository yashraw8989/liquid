</button>


  {% else %}
    <button type="button" class="cart-button none collection" disabled>Sold Out</button>
  {% endif %}
</div>


<!-- Size Selection Modal -->
<article class="selectSize slideUpSizes selectSizeToggle" id="realtime-size-{{ product.variants.first.id }}" style="display: none;">
  <p>Select a size
    <button type="button" class="close buyClose closeBuy close-modal" id="closeBuy-realtime-size">×</button>
  </p>
  <div>
    <ul class="P2-sizes" id="size-list-{{ product.variants.first.id }}">
      <!-- Sizes will be dynamically populated here -->
    </ul>
  </div>
</article>

<script>
document.addEventListener('DOMContentLoaded', function () {
  let activeModal = null; // Track the currently active modal

  // Function to close any open modal instantly
  function closeOpenModal() {
    if (activeModal) {
      activeModal.classList.remove('slide-up'); // Remove animation class
      activeModal.classList.add('hide'); // Add hide class
      activeModal.style.display = 'none'; // Instantly hide
      activeModal = null; // Reset active modal
    }
  }

  // Function to show the size selection modal for a product
  function showSizeSelection(productId, productHandle) {
    if (activeModal) {
      closeOpenModal(); // Close any open modal before showing a new one
    }



     // console.log(productId);
 //  const articles = document.querySelectorAll('.selectSize');

 //    // Loop through each article and update the id
 //    articles.forEach(article => {
 //        if (productId) {
 //            article.id = 'realtime-size-' + productId; // Update the article ID with the variant ID
 //        }
 //    });
   

    const sizeModal = document.getElementById('realtime-size-' + productId);

    if (!sizeModal) {
      console.error('Modal not found for product ID:', productId);
      return;
    }

    const productUrl = productHandle.endsWith('.js') ? productHandle : `${productHandle}.js`;

    console.log(`Fetching product data for handle: ${productHandle}`);

    fetch(productUrl)
      .then((response) => {
        if (!response.ok) {
          throw new Error('Product not found');
        }
        return response.json();
      })
      .then((product) => {
        console.log('Product data fetched successfully:', product);

        const sizeList = document.getElementById('size-list-' + productId);
        sizeList.innerHTML = ''; // Clear previous variants

        product.variants.forEach((variant) => {
          const sizeItem = document.createElement('li');
          if (variant.available) {
            sizeItem.innerHTML = `<a data-variant-id="${variant.id}" class="in-stock">${variant.title}</a>`;
          } else {
            sizeItem.innerHTML = `<span class="out-of-stock">${variant.title}</span>`;
          }
          sizeList.appendChild(sizeItem);
        });

        // Show the new modal
        sizeModal.style.display = 'block';
        sizeModal.classList.remove('hide'); // Ensure 'hide' class is removed
        sizeModal.classList.add('slide-up'); // Add animation class

        activeModal = sizeModal; // Set the new modal as active
        console.log('Size modal displayed:', sizeModal.id);
      })
      .catch((error) => {
        console.error('Error fetching product:', error);
      });
  }

  // Attach click event to Add to Cart buttons
  function attachEventListeners() {
    document.querySelectorAll('.add-to-cart-button').forEach((button) => {
      if (!button.classList.contains('listener-added')) {
        button.classList.add('listener-added'); // Prevent duplicate event listeners

        button.addEventListener('click', function (event) {
          event.preventDefault();
          const productId = this.getAttribute('data-product-id');
          const productHandle = this.getAttribute('data-product-handle');

          console.log(`Add to Cart button clicked. Product ID: ${productId} Handle: ${productHandle}`);

          showSizeSelection(productId, productHandle);
        });
      }
    });
  }

  // Handle click on modal close buttons
  document.addEventListener('click', function (event) {
    if (event.target.matches('.close-modal')) {
      console.log('Close button clicked');
      closeOpenModal();
    }
  });

  // Reapply event listeners on DOM changes using MutationObserver
  const observer = new MutationObserver(() => {
    attachEventListeners(); // Reattach event listeners when DOM changes
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true, // Monitor changes in the whole subtree
  });

  // Handle size selection and add to cart
  document.addEventListener('click', function (event) {
    if (event.target.closest('.P2-sizes a')) {
      const selectedVariantId = event.target.getAttribute('data-variant-id');
      const modal = event.target.closest('.selectSize');

      // Add product to cart with the selected variant
      addToCart(selectedVariantId).then(() => {
        // Close the modal after adding to cart
        closeOpenModal();

        // Show notification
        showNotification('Product added to cart');
      });
    }
  });

  // Function to add product to the cart with selected variant
  function addToCart(variantId) {
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1,
      }),
    })
      .then((response) => response.json())
      .then((cart) => {
        console.log('Product added to cart:', cart);
      })
      .catch((error) => {
        console.error('Error adding product to cart:', error);
      });
  }

  // Function to show notification
  function showNotification(message) {
    const notification = document.createElement('div');
    notification.className = 'notification';
    notification.textContent = message;
    document.body.appendChild(notification);
    setTimeout(() => {
      notification.classList.add('show');
      setTimeout(() => {
        notification.classList.remove('show');
        notification.addEventListener(
          'transitionend',
          () => {
            notification.remove();
          },
          { once: true }
        );
      }, 1000);
    }, 10);
  }


  // Initial event listener attachment
  attachEventListeners();
});
  
</script>

