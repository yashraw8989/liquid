            </a>
          </facet-remove>
        </div>
      </form>
    </facet-filters-form>
  {%- endif -%}
</div>
                                       <div class="section-{{ section.id }}-padding">
  <!-- Add the Horizontal Color Filter -->
  <div id="color-filter">
    <button class="color-filter-button" data-color="all">All</button>
    {% assign colors = "" %}
    {% for product in collection.products %}
      {% assign product_color = product.metafields.custom.product_color_name.value %}
      {% if product_color and product_color != "" and colors contains product_color %}
        {% continue %}
      {% endif %}
      {% assign colors = colors | append: product_color | append: "," %}
      {% if product_color and product_color != "" %}
        <button class="color-filter-button" data-color="{{ product_color }}">{{ product_color }}
          <span class="remove-filter">&times;</span>
        </button>
      {% endif %}
    {% endfor %}
  </div>
                                        </div>
                                   